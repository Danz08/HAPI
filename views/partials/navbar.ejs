<header class="navbar-glass sticky top-0 z-40 pl-14 pr-2 sm:pr-4 lg:px-8 py-3 sm:py-4 backdrop-blur-xl border-b border-surface-700/30 flex flex-row items-center justify-between mb-4 sm:mb-8 transition-colors">
  <div class="min-w-0 mr-2">
    <h2 class="text-lg sm:text-2xl md:text-3xl font-bold font-display text-surface-50 tracking-tight truncate" id="page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
    <p class="text-xs md:text-sm text-surface-400 mt-1 hidden sm:flex items-center gap-1.5 font-mono">
      <i data-lucide="clock" class="w-3.5 h-3.5"></i>
      <span class="live-time-display" id="live-datetime">--:--</span>
    </p>
  </div>
  <div class="flex items-center gap-1 sm:gap-2 shrink-0">
    <% if (user && user.is_onboarded) { %>
    <button onclick="openGlobalMood()" class="btn-secondary btn-sm" id="btn-quick-mood" title="Log Mood">
      <i data-lucide="smile" class="w-4 h-4"></i>
      <span class="hidden sm:inline" >Catat Mood</span>
    </button>
    <% } %>
    <button onclick="toggleTheme()" class="btn-ghost btn-sm" id="btn-theme" title="Ganti Tema">
      <i data-lucide="sun" class="w-4 h-4" id="theme-icon"></i>
    </button>
  </div>
</header>
