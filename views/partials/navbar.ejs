<header class="navbar-glass mb-8">
  <div>
    <h2 class="text-2xl md:text-3xl font-bold font-display text-surface-50 tracking-tight" id="page-title" data-i18n="<%= typeof pageKey !== 'undefined' ? pageKey : 'page.dashboard' %>">
      <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %>
    </h2>
    <p class="text-xs md:text-sm text-surface-400 mt-1 flex items-center gap-1.5 font-mono">
      <i data-lucide="clock" class="w-3.5 h-3.5"></i>
      <span id="live-datetime">--:--</span>
    </p>
  </div>
  <div class="flex items-center gap-2">
    <button onclick="openMoodModal()" class="btn-secondary btn-sm" id="btn-quick-mood" data-i18n-title="btn.mood" title="Log Mood">
      <i data-lucide="smile" class="w-4 h-4"></i>
      <span class="hidden sm:inline" data-i18n="btn.mood">Catat Mood</span>
    </button>
    <button onclick="toggleTheme()" class="btn-ghost btn-sm" id="btn-theme" data-i18n-title="btn.theme" title="Ganti Tema">
      <i data-lucide="sun" class="w-4 h-4" id="theme-icon"></i>
    </button>
    <button onclick="toggleLang()" class="btn-ghost btn-sm" id="btn-lang" data-i18n-title="btn.lang" title="Ganti Bahasa">
      <span class="text-xs font-bold" id="lang-label">ID</span>
    </button>
  </div>
</header>
