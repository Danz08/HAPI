<!-- Flash Messages via SweetAlert -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const isDarkMode = document.documentElement.getAttribute('data-theme') !== 'light';
    const bg = isDarkMode ? '#1e1611' : '#ffffff';
    const color = isDarkMode ? '#f8f4f0' : '#3a1e13';
    const backdrop = 'rgba(0,0,0,0.75)';

    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <% success.forEach(function(msg) { %>
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Sukses',
            text: "<%= msg %>",
            icon: 'success',
            background: bg,
            color: color,
            backdrop: backdrop,
            confirmButtonColor: '#A86240',
            customClass: { container: 'z-[99999]' }
          });
        }
      <% }) %>
    <% } %>

    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <% error.forEach(function(msg) { %>
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Error',
            text: "<%= msg %>",
            icon: 'error',
            background: bg,
            color: color,
            backdrop: backdrop,
            confirmButtonColor: '#ef4444',
            customClass: { container: 'z-[99999]' }
          });
        }
      <% }) %>
    <% } %>

    <% if (typeof warning !== 'undefined' && warning && warning.length > 0) { %>
      <% warning.forEach(function(msg) { %>
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Peringatan',
            text: "<%= msg %>",
            icon: 'warning',
            background: bg,
            color: color,
            backdrop: backdrop,
            confirmButtonColor: '#f59e0b',
            customClass: { container: 'z-[99999]' }
          });
        }
      <% }) %>
    <% } %>
  });
</script>
