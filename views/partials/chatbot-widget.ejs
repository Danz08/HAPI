<!-- Floating Chatbot Widget — Modern, polished design -->
<div id="chatbot-widget" class="fixed bottom-6 right-6 z-50">
  <!-- Chat Window -->
  <div id="chatbot-window" class="hidden absolute bottom-20 right-0 w-[400px] max-w-[calc(100vw-2rem)] animate-scale-in origin-bottom-right">
    <div class="glass-card overflow-hidden shadow-2xl shadow-black/30 border border-surface-600/40 flex flex-col" style="height: 560px">
      <!-- Chat Header -->
      <div class="px-5 py-4 bg-gradient-to-r from-brand-600/30 to-accent-purple/20 border-b border-surface-700/50 backdrop-blur-xl flex-shrink-0">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl gradient-brand flex items-center justify-center shadow-lg shadow-brand-600/20">
              <i data-lucide="bot" class="w-5 h-5 text-white"></i>
            </div>
            <div>
              <p class="font-bold text-sm text-surface-100" >HAPI Asisten</p>
              <p class="text-[11px] text-success-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-success-400 rounded-full animate-pulse-soft"></span>
                <span >Siap membantumu</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <button onclick="clearWidgetChat()" class="p-2 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" title="Hapus chat">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
            <button onclick="toggleChatbot()" class="p-2 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" title="Tutup">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Chat Messages -->
      <div id="widget-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4" style="min-height: 0">
        <!-- Welcome message -->
        <div class="flex justify-start animate-fade-in">
          <div class="flex gap-2.5 max-w-[85%]">
            <div class="w-7 h-7 rounded-lg gradient-brand flex items-center justify-center flex-shrink-0 mt-0.5">
              <i data-lucide="bot" class="w-3.5 h-3.5 text-white"></i>
            </div>
            <div class="widget-bubble-ai">
              <p class="text-sm leading-relaxed" >Halo! 👋 Aku HAPI Asisten. Ceritakan apa yang kamu rasakan, atau tanyakan apa saja seputar produktivitas dan kesehatanmu.</p>
            </div>
          </div>
        </div>

        <!-- Chatbot Suggestions -->
        <div id="chatbot-suggestions" class="flex flex-col gap-2 mt-4 animate-fade-in">
          <p class="text-xs text-center text-surface-400 mb-1" >Pilih topik untuk memulai percakapan:</p>
          <button onclick="startChatSuggestion('chat.quick.stress')" class="w-full text-left p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700 border border-surface-600/30 transition-colors text-sm text-surface-200"><span >😩 Aku merasa stres</span></button>
          <button onclick="startChatSuggestion('chat.quick.tired')" class="w-full text-left p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700 border border-surface-600/30 transition-colors text-sm text-surface-200"><span >😴 Aku merasa lelah</span></button>
          <button onclick="startChatSuggestion('chat.quick.sad')" class="w-full text-left p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700 border border-surface-600/30 transition-colors text-sm text-surface-200"><span >😢 Aku merasa sedih</span></button>
          <button onclick="startChatSuggestion('chat.quick.happy')" class="w-full text-left p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700 border border-surface-600/30 transition-colors text-sm text-surface-200"><span >😊 Aku merasa senang</span></button>
          <button onclick="startChatCustom()" class="w-full text-center p-3 rounded-xl bg-brand-600/20 hover:bg-brand-600/30 border border-brand-500/30 transition-colors text-sm font-medium text-brand-300 mt-2" >Ketik pesan sendiri...</button>
        </div>
      </div>

      <!-- Chat Input -->
      <div id="widget-input-container" class="px-4 py-3 border-t border-surface-700/50 bg-surface-900/50 backdrop-blur-xl flex-shrink-0 hidden">
        <form id="widget-chat-form" class="flex gap-2">
          <input type="text" id="widget-chat-input" placeholder="Ketik pesanmu di sini..." class="flex-1 px-4 py-2.5 bg-surface-800/70 border border-surface-600/50 rounded-xl text-sm text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all" autocomplete="off">
          <button type="submit" class="p-2.5 rounded-xl bg-brand-600 text-white hover:bg-brand-500 transition-all active:scale-95 shadow-lg shadow-brand-600/25 disabled:opacity-50 disabled:cursor-not-allowed" id="widget-send-btn">
            <i data-lucide="send" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Floating Action Button -->
  <button id="chatbot-fab" onclick="toggleChatbot()" class="relative group">
    <div class="w-14 h-14 rounded-2xl gradient-brand flex items-center justify-center shadow-xl shadow-brand-600/30 hover:shadow-2xl hover:shadow-brand-600/40 transition-all duration-300 hover:scale-110 active:scale-95">
      <i data-lucide="message-circle" class="w-6 h-6 text-white chatbot-icon-open"></i>
      <i data-lucide="x" class="w-6 h-6 text-white chatbot-icon-close hidden"></i>
    </div>
    <!-- Pulse ring -->
    <div class="absolute inset-0 rounded-2xl gradient-brand opacity-30 animate-ping pointer-events-none" id="chatbot-ping"></div>
    <!-- Notification badge -->
    <div class="absolute -top-1 -right-1 w-5 h-5 bg-danger-500 rounded-full flex items-center justify-center text-[10px] text-white font-bold shadow-lg" id="chatbot-badge" style="display: none">1</div>
    <!-- Tooltip -->
    <div class="absolute bottom-full right-0 mb-2 px-3 py-1.5 bg-surface-800 rounded-lg text-xs text-surface-200 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none border border-surface-700/50 shadow-lg">
      💬 Chat with HAPI
    </div>
  </button>
</div>

<script>
// Chatbot Widget Logic
let chatbotOpen = false;

function toggleChatbot() {
  chatbotOpen = !chatbotOpen;
  const chatWindow = document.getElementById('chatbot-window');
  const iconOpen = document.querySelector('.chatbot-icon-open');
  const iconClose = document.querySelector('.chatbot-icon-close');
  const ping = document.getElementById('chatbot-ping');
  const badge = document.getElementById('chatbot-badge');

  if (chatbotOpen) {
    chatWindow.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    ping?.classList.add('hidden');
    if (badge) badge.style.display = 'none';
    document.getElementById('widget-chat-input')?.focus();
    const msgs = document.getElementById('widget-chat-messages');
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  } else {
    chatWindow.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }
  lucide.createIcons();
}

function startChatSuggestion(key) {
  const msg = 'Pesan';
  startChatCustom();
  const input = document.getElementById('widget-chat-input');
  if (input) {
    input.value = msg;
    document.getElementById('widget-chat-form')?.dispatchEvent(new Event('submit'));
  }
}

function startChatCustom() {
  const sugg = document.getElementById('chatbot-suggestions');
  if (sugg) sugg.style.display = 'none';
  const inpCont = document.getElementById('widget-input-container');
  if (inpCont) {
    inpCont.classList.remove('hidden');
    document.getElementById('widget-chat-input')?.focus();
  }
}

function appendWidgetMessage(role, text) {
  const container = document.getElementById('widget-chat-messages');
  if (!container) return;

  const div = document.createElement('div');
  div.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'} animate-fade-in`;

  if (role === 'ai') {
    div.innerHTML = `<div class="flex gap-2.5 max-w-[85%]"><div class="w-7 h-7 rounded-lg gradient-brand flex items-center justify-center flex-shrink-0 mt-0.5"><i data-lucide="bot" class="w-3.5 h-3.5 text-white"></i></div><div class="widget-bubble-ai"><p class="text-sm leading-relaxed">${text}</p></div></div>`;
  } else {
    div.innerHTML = `<div class="widget-bubble-user"><p class="text-sm leading-relaxed">${text}</p></div>`;
  }

  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  lucide.createIcons();
}

function showWidgetTyping() {
  const container = document.getElementById('widget-chat-messages');
  if (!container) return null;

  const id = 'widget-typing-' + Date.now();
  const div = document.createElement('div');
  div.id = id;
  div.className = 'flex justify-start animate-fade-in';
  div.innerHTML = `<div class="flex gap-2.5"><div class="w-7 h-7 rounded-lg gradient-brand flex items-center justify-center flex-shrink-0 mt-0.5"><i data-lucide="bot" class="w-3.5 h-3.5 text-white"></i></div><div class="widget-bubble-ai"><div class="flex gap-1.5 items-center py-1"><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0s"></span><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0.15s"></span><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0.3s"></span></div></div></div>`;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  lucide.createIcons();
  return id;
}

// Chat form submit
document.getElementById('widget-chat-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const input = document.getElementById('widget-chat-input');
  const sendBtn = document.getElementById('widget-send-btn');
  const msg = input?.value.trim();
  if (!msg) return;

  appendWidgetMessage('user', msg);
  input.value = '';
  if (sendBtn) sendBtn.disabled = true;

  // Hide suggestions if they somehow aren't
  const sugg = document.getElementById('chatbot-suggestions');
  if (sugg) sugg.style.display = 'none';

  const typingId = showWidgetTyping();

  try {
     const res = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg, language: 'id' })
    });

    // Placeholder: simulate a response for now
    await new Promise(resolve => setTimeout(resolve, 1200));
    if (typingId) document.getElementById(typingId)?.remove();

    const placeholderResponse = generatePlaceholderResponse(msg);
    appendWidgetMessage('ai', placeholderResponse);
  } catch(err) {
    if (typingId) document.getElementById(typingId)?.remove();
    appendWidgetMessage('ai', 'Maaf, terjadi kesalahan koneksi. Coba lagi ya.');
  } finally {
    if (sendBtn) sendBtn.disabled = false;
  }
});

/**
 * Placeholder response generator — will be replaced with actual AI API
 */
function generatePlaceholderResponse(message) {
  const lowerMsg = message.toLowerCase();
  
  if (lowerMsg.includes('stres') || lowerMsg.includes('stress')) {
    return 'Aku mengerti kamu sedang tertekan. Coba tarik nafas dalam 3 kali, lalu ceritakan lebih lanjut apa yang membuatmu stres. Kamu juga bisa coba sesi Pomodoro untuk mengatur ritme kerjamu. 💆';
  }
  if (lowerMsg.includes('lelah') || lowerMsg.includes('capek') || lowerMsg.includes('tired')) {
    return 'Tubuhmu memberi sinyal untuk istirahat. Pastikan kamu cukup minum air dan tidur 7-9 jam. Coba ambil Quiz Kelelahan untuk cek kondisimu ya! 😴';
  }
  if (lowerMsg.includes('sedih') || lowerMsg.includes('sad')) {
    return 'Perasaan sedih itu valid. Tidak perlu terburu-buru untuk merasa baik. Coba catat moodmu di fitur Mood Logger, dan ingat — kamu tidak sendirian. 💙';
  }
  if (lowerMsg.includes('senang') || lowerMsg.includes('happy') || lowerMsg.includes('baik')) {
    return 'Senang mendengarnya! 😊 Manfaatkan energi positif ini untuk hal-hal produktif. Cek Dashboard untuk melihat progress harianmu!';
  }
  if (lowerMsg.includes('fokus') || lowerMsg.includes('focus') || lowerMsg.includes('konsentrasi')) {
    return 'Tips fokus: 1) Gunakan teknik Pomodoro 25/5, 2) Matikan notifikasi yang mengganggu, 3) Tentukan satu prioritas utama, 4) Pastikan tempat kerjamu nyaman. Coba mulai sesi Pomodoro sekarang! 🎯';
  }
  if (lowerMsg.includes('tidur') || lowerMsg.includes('sleep') || lowerMsg.includes('insomnia')) {
    return 'Kualitas tidur sangat penting. Coba: 1) Hindari layar 1 jam sebelum tidur, 2) Buat rutinitas tidur yang konsisten, 3) Kurangi kafein setelah jam 2 siang. Tidur yang cukup sangat mempengaruhi produktivitas. 🌙';
  }
  return 'Terima kasih sudah berbagi! Aku di sini untuk membantumu. Kamu bisa ceritakan perasaanmu, tanya tips produktivitas, atau coba fitur-fitur HAPI seperti Pomodoro Timer dan Quiz Kelelahan. 🤗';
}

async function clearWidgetChat() {
  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  Swal.fire({
    title: 'Hapus Riwayat?',
    text: 'Semua riwayat chat akan dihapus.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Ya, hapus!',
    cancelButtonText: 'Batal',
    confirmButtonColor: '#A86240',
    cancelButtonColor: '#489A98',
    background: isDark ? '#1e1611' : '#ffffff',
    color: isDark ? '#f8f4f0' : '#3a1e13',
    backdrop: 'rgba(0,0,0,0.75)',
    position: 'center',
    customClass: {
      container: 'z-[99999]'
    }
  }).then(async (result) => {
    if (result.isConfirmed) {
      try {
        // TODO: Uncomment when API is integrated
        // await axios.delete('/api/chat');
        const container = document.getElementById('widget-chat-messages');
        if (container) {
          const clearedMsg = 'Percakapan telah dibersihkan! ✨ Ada yang bisa kubantu?';
          container.innerHTML = `<div class="flex justify-start animate-fade-in"><div class="flex gap-2.5 max-w-[85%]"><div class="w-7 h-7 rounded-lg gradient-brand flex items-center justify-center flex-shrink-0 mt-0.5"><i data-lucide="bot" class="w-3.5 h-3.5 text-white"></i></div><div class="widget-bubble-ai"><p class="text-sm leading-relaxed">${clearedMsg}</p></div></div></div>`;
          lucide.createIcons();
        }
        const sugg = document.getElementById('chatbot-suggestions');
        const inpCont = document.getElementById('widget-input-container');
        if (sugg && inpCont) {
          sugg.style.display = 'flex';
          inpCont.classList.add('hidden');
        }
      } catch(err) {
        // Silently fail
      }
    }
  });
}

// Auto show badge after 10 seconds if not opened
setTimeout(() => {
  if (!chatbotOpen) {
    const badge = document.getElementById('chatbot-badge');
    if (badge) badge.style.display = 'flex';
  }
}, 10000);
</script>
