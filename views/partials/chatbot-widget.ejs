<!-- Floating Chatbot Widget — Modern, polished design -->
<div id="chatbot-widget" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50">
  <!-- Chat Window -->
  <div id="chatbot-window" class="hidden fixed inset-0 sm:inset-auto sm:absolute sm:bottom-20 sm:right-0 sm:w-[400px] sm:max-w-[calc(100vw-2rem)] animate-scale-in origin-bottom-right z-50">
    <div class="glass-card overflow-hidden shadow-2xl shadow-black/30 border border-surface-600/40 flex flex-col h-full sm:h-auto sm:rounded-2xl rounded-none" style="height: 100dvh; max-height: 100dvh;" id="chatbot-window-inner">
      <!-- Chat Header -->
      <div class="px-5 py-4 bg-gradient-to-r from-brand-600/30 to-accent-purple/20 border-b border-surface-700/50 backdrop-blur-xl flex-shrink-0">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl gradient-brand flex items-center justify-center shadow-lg shadow-brand-600/20">
              <i data-lucide="bot" class="w-5 h-5 text-white"></i>
            </div>
            <div>
              <p class="font-bold text-sm text-surface-100" >HAPI Asisten</p>
              <p class="text-[11px] text-success-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-success-400 rounded-full animate-pulse-soft"></span>
                <span >Siap membantumu</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <button onclick="clearWidgetChat()" class="p-2 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" title="Hapus chat">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
            <button onclick="toggleChatbot()" class="p-2 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" title="Tutup">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Disclaimer Banner -->
      <div class="px-4 py-2 bg-warning-500/10 border-b border-warning-500/20 text-[10px] text-warning-200/90 text-center flex-shrink-0">
        <i data-lucide="info" class="w-3 h-3 inline-block mr-1 -mt-0.5"></i> HAPI bukan pengganti konselor atau psikolog. Jika kamu merasa membutuhkan bantuan profesional, hubungi konselor kampus atau layanan kesehatan jiwa.
      </div>

      <!-- Crisis Banner (Hidden by default) -->
      <div id="crisis-banner" class="hidden px-4 py-3 bg-danger-500/20 border-b border-danger-500/30 text-xs text-danger-200 flex-shrink-0 animate-fade-in">
        <div class="flex gap-2">
          <i data-lucide="alert-circle" class="w-4 h-4 text-danger-400 flex-shrink-0 mt-0.5"></i>
          <div>
            <p class="font-bold mb-1">Kalau kamu sedang butuh bantuan segera:</p>
            <ul class="list-disc pl-4 space-y-0.5 opacity-90">
              <li>Into The Light Indonesia: 119 ext 8</li>
              <li>Yayasan Pulih: (021) 788-42580</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Chat Messages -->
      <div id="widget-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4" style="min-height: 0"></div>

      <!-- Dynamic Chips Container -->
      <div id="chatbot-dynamic-chips" class="hidden px-4 pb-2 pt-1 flex-wrap gap-2 animate-fade-in flex-shrink-0 border-t border-surface-700/50 bg-surface-900/50 backdrop-blur-xl">
        <!-- Chips injected here -->
      </div>

      <!-- Chat Input -->
      <div id="widget-input-container" class="px-4 py-3 border-t border-surface-700/50 bg-surface-900/50 backdrop-blur-xl flex-shrink-0 hidden pb-safe">
        <form id="widget-chat-form" class="flex gap-2">
          <input type="text" id="widget-chat-input" placeholder="Ketik pesanmu di sini..." class="flex-1 px-4 py-2.5 bg-surface-800/70 border border-surface-600/50 rounded-xl text-sm text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all" autocomplete="off">
          <button type="submit" class="p-2.5 rounded-xl bg-brand-600 text-white hover:bg-brand-500 transition-all active:scale-95 shadow-lg shadow-brand-600/25 disabled:opacity-50 disabled:cursor-not-allowed" id="widget-send-btn">
            <i data-lucide="send" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Floating Action Button -->
  <button id="chatbot-fab" onclick="toggleChatbot()" class="relative group">
    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl gradient-brand flex items-center justify-center shadow-xl shadow-brand-600/30 hover:shadow-2xl hover:shadow-brand-600/40 transition-all duration-300 hover:scale-110 active:scale-95">
      <i data-lucide="message-circle" class="w-5 h-5 sm:w-6 sm:h-6 text-white chatbot-icon-open"></i>
      <i data-lucide="x" class="w-5 h-5 sm:w-6 sm:h-6 text-white chatbot-icon-close hidden"></i>
    </div>
    <!-- Pulse ring -->
    <div class="absolute inset-0 rounded-2xl gradient-brand opacity-30 animate-ping pointer-events-none" id="chatbot-ping"></div>
    <!-- Notification badge -->
    <div class="absolute -top-1 -right-1 w-5 h-5 bg-danger-500 rounded-full flex items-center justify-center text-[10px] text-white font-bold shadow-lg" id="chatbot-badge" style="display: none">1</div>
    <!-- Tooltip -->
    <div class="absolute bottom-full right-0 mb-2 px-3 py-1.5 bg-surface-800 rounded-lg text-xs text-surface-200 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none border border-surface-700/50 shadow-lg hidden sm:block">
      💬 Chat with HAPI
    </div>
  </button>
</div>

<script>
// Chatbot Widget Logic
let chatbotOpen = false;

let chatbotInitialized = false;

function toggleChatbot() {
  chatbotOpen = !chatbotOpen;
  const chatWindow = document.getElementById('chatbot-window');
  const chatWindowInner = document.getElementById('chatbot-window-inner');
  const iconOpen = document.querySelector('.chatbot-icon-open');
  const iconClose = document.querySelector('.chatbot-icon-close');
  const ping = document.getElementById('chatbot-ping');
  const badge = document.getElementById('chatbot-badge');
  const fab = document.getElementById('chatbot-fab');
  const isMobile = window.innerWidth < 640;

  if (chatbotOpen) {
    chatWindow.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    ping?.classList.add('hidden');
    if (badge) badge.style.display = 'none';
    // Hide FAB on mobile when chat is open
    if (isMobile && fab) fab.classList.add('hidden');
    // Set height for desktop
    if (!isMobile && chatWindowInner) {
      chatWindowInner.style.height = '560px';
      chatWindowInner.style.maxHeight = '560px';
    }
    
    // Init conversation if empty
    if (!chatbotInitialized) {
      document.getElementById('widget-input-container').classList.remove('hidden');
      chatbotInitialized = true;
      loadChatHistory();
    } else {
      document.getElementById('widget-chat-input')?.focus();
    }
    
    const msgs = document.getElementById('widget-chat-messages');
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  } else {
    chatWindow.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    if (fab) fab.classList.remove('hidden');
  }
  lucide.createIcons();
}

async function loadChatHistory() {
  try {
    const res = await fetch('/api/chat');
    if (res.ok) {
      const data = await res.json();
      if (data.history && data.history.length > 0) {
        // render history
        for (const msg of data.history) {
          if (msg.role === 'user' && msg.message === 'START') continue;
          // Convert newlines to br for AI messages
          let text = msg.message;
          if (msg.role === 'ai') {
            text = text.replace(/\n/g, '<br/>');
          }
          appendWidgetMessage(msg.role, text);
        }
        
        // render chips if any
        if (data.chips && data.chips.length > 0) {
          const chipsContainer = document.getElementById('chatbot-dynamic-chips');
          if (chipsContainer) {
            chipsContainer.innerHTML = data.chips.slice(0, 4).map(c => 
              `<button onclick="sendChip('${c.value}')" class="px-3 py-1.5 rounded-full bg-surface-800 hover:bg-surface-700 border border-surface-600/50 hover:border-brand-500/50 transition-colors text-xs text-surface-200 max-w-[200px] truncate" title="${c.text}">${c.text}</button>`
            ).join('');
            chipsContainer.classList.remove('hidden');
          }
        }
      } else {
        triggerBotResponse('START');
      }
    } else {
      triggerBotResponse('START');
    }
  } catch(e) {
    triggerBotResponse('START');
  }
}

function sendChip(text) {
  const input = document.getElementById('widget-chat-input');
  if (input) {
    input.value = text;
    document.getElementById('widget-chat-form')?.dispatchEvent(new Event('submit'));
  }
}

function appendWidgetMessage(role, text) {
  const container = document.getElementById('widget-chat-messages');
  if (!container) return;

  const div = document.createElement('div');
  div.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'} animate-fade-in`;

  if (role === 'ai') {
    div.innerHTML = `<div class="flex gap-2.5 max-w-[85%]"><div class="w-7 h-7 rounded-lg gradient-brand flex items-center justify-center flex-shrink-0 mt-0.5"><i data-lucide="bot" class="w-3.5 h-3.5 text-white"></i></div><div class="widget-bubble-ai"><p class="text-sm leading-relaxed">${text}</p></div></div>`;
  } else {
    div.innerHTML = `<div class="widget-bubble-user"><p class="text-sm leading-relaxed">${text}</p></div>`;
  }

  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  lucide.createIcons();
}

function showWidgetTyping() {
  const container = document.getElementById('widget-chat-messages');
  if (!container) return null;

  const id = 'widget-typing-' + Date.now();
  const div = document.createElement('div');
  div.id = id;
  div.className = 'flex justify-start animate-fade-in';
  div.innerHTML = `<div class="flex gap-2.5"><div class="w-7 h-7 rounded-lg gradient-brand flex items-center justify-center flex-shrink-0 mt-0.5"><i data-lucide="bot" class="w-3.5 h-3.5 text-white"></i></div><div class="widget-bubble-ai"><div class="flex gap-1.5 items-center py-1"><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0s"></span><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0.15s"></span><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0.3s"></span></div></div></div>`;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  lucide.createIcons();
  return id;
}


// Process array of responses sequentially
async function processSequencedResponses(responses, chips, isCrisis, emotionLabel) {
  const chipsContainer = document.getElementById('chatbot-dynamic-chips');
  if (chipsContainer) {
    chipsContainer.innerHTML = '';
    chipsContainer.classList.add('hidden');
  }

  if (isCrisis) {
    const banner = document.getElementById('crisis-banner');
    if (banner) banner.classList.remove('hidden');
  }

  for (let i = 0; i < responses.length; i++) {
    const r = responses[i];
    
    // Show typing if delay > 0
    let typingId = null;
    if (r.delay > 0) {
      typingId = showWidgetTyping();
      await new Promise(res => setTimeout(res, r.delay));
      if (typingId) document.getElementById(typingId)?.remove();
    }

    let aiMsg = r.text;
    
    // Append emotion tag only on the first bubble of a response sequence
    if (i === 0 && emotionLabel) {
      const emotionTag = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-brand-600/20 text-brand-300 mb-2">🧠 Emosi: ${emotionLabel}</span><br/>`;
      aiMsg = emotionTag + aiMsg;
    }

    // Convert newlines to br
    aiMsg = aiMsg.replace(/\n/g, '<br/>');
    appendWidgetMessage('ai', aiMsg);
  }

  // Render chips after all messages are sent
  if (chips && chips.length > 0 && chipsContainer) {
    chipsContainer.innerHTML = chips.slice(0, 4).map(c => 
      `<button onclick="sendChip('${c.value}')" class="px-3 py-1.5 rounded-full bg-surface-800 hover:bg-surface-700 border border-surface-600/50 hover:border-brand-500/50 transition-colors text-xs text-surface-200 max-w-[200px] truncate" title="${c.text}">${c.text}</button>`
    ).join('');
    chipsContainer.classList.remove('hidden');
  }
}

// Separate API call logic for reusability (init vs user input)
async function triggerBotResponse(msg) {
  const sendBtn = document.getElementById('widget-send-btn');
  if (sendBtn) sendBtn.disabled = true;

  const typingId = showWidgetTyping();

  try {
    const res = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg })
    });

    if (typingId) document.getElementById(typingId)?.remove();

    if (res.ok) {
      const data = await res.json();
      if (data.responses && data.responses.length > 0) {
        await processSequencedResponses(data.responses, data.chips, data.isCrisis, data.emotion);
      } else {
        appendWidgetMessage('ai', data.response || 'Maaf, aku tidak bisa menjawab sekarang.');
      }
    } else {
      appendWidgetMessage('ai', 'Maaf, terjadi kesalahan. Coba lagi ya.');
    }
  } catch(err) {
    if (typingId) document.getElementById(typingId)?.remove();
    appendWidgetMessage('ai', 'Maaf, terjadi kesalahan koneksi. Coba lagi ya.');
  } finally {
    if (sendBtn) sendBtn.disabled = false;
    document.getElementById('widget-chat-input')?.focus();
  }
}

// Chat form submit
document.getElementById('widget-chat-form')?.addEventListener('submit', (e) => {
  e.preventDefault();
  const input = document.getElementById('widget-chat-input');
  const msg = input?.value.trim();
  if (!msg) return;

  // Hide chips on send
  const chipsContainer = document.getElementById('chatbot-dynamic-chips');
  if (chipsContainer) {
    chipsContainer.classList.add('hidden');
    chipsContainer.innerHTML = '';
  }

  appendWidgetMessage('user', msg);
  input.value = '';
  
  triggerBotResponse(msg);
});

async function clearWidgetChat() {
  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  Swal.fire({
    title: 'Hapus Riwayat?',
    text: 'Semua riwayat chat akan dihapus.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Ya, hapus!',
    cancelButtonText: 'Batal',
    confirmButtonColor: '#A86240',
    cancelButtonColor: '#489A98',
    background: isDark ? '#1e1611' : '#ffffff',
    color: isDark ? '#f8f4f0' : '#3a1e13',
    backdrop: 'rgba(0,0,0,0.75)',
    position: 'center',
    customClass: {
      container: 'z-[99999]'
    }
  }).then(async (result) => {
    if (result.isConfirmed) {
      try {
        await fetch('/api/chat', { method: 'DELETE' });
        const container = document.getElementById('widget-chat-messages');
        if (container) {
          container.innerHTML = '';
        }
        
        chatbotInitialized = false;
        if (chatbotOpen) {
          chatbotInitialized = true;
          triggerBotResponse('START');
        }
      } catch(err) {
        // Silently fail
      }
    }
  });
}

// Auto show badge after 10 seconds if not opened
setTimeout(() => {
  if (!chatbotOpen) {
    const badge = document.getElementById('chatbot-badge');
    if (badge) badge.style.display = 'flex';
  }
}, 10000);
</script>
