<!-- Floating Chatbot Widget - Appears on all authenticated pages -->
<div id="chatbot-widget" class="fixed bottom-6 right-6 z-50">
  <!-- Chat Window -->
  <div id="chatbot-window" class="hidden absolute bottom-20 right-0 w-[380px] max-w-[calc(100vw-2rem)] animate-scale-in origin-bottom-right">
    <div class="glass-card overflow-hidden shadow-2xl shadow-black/30 border border-surface-600/40" style="height: 520px">
      <!-- Chat Header -->
      <div class="px-4 py-3 bg-gradient-to-r from-brand-600/30 to-accent-purple/20 border-b border-surface-700/50 backdrop-blur-xl">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full gradient-accent flex items-center justify-center shadow-lg shadow-accent-purple/20">
              <i data-lucide="bot" class="w-4.5 h-4.5 text-white"></i>
            </div>
            <div>
              <p class="font-semibold text-sm text-surface-100" data-i18n="chat.name">HAPI Buddy</p>
              <p class="text-[10px] text-success-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-success-400 rounded-full animate-pulse-soft"></span> <span data-i18n="chat.status">Selalu ada untukmu</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <button onclick="clearWidgetChat()" class="p-1.5 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" title="Hapus chat">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
            <button onclick="toggleChatbot()" class="p-1.5 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" title="Tutup">
              <i data-lucide="minimize-2" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="px-3 py-2 border-b border-surface-700/30 flex gap-1.5 overflow-x-auto" id="chatbot-quick-actions">
        <button onclick="sendQuickMessage('Aku merasa stres')" class="quick-chip">😩 Stres</button>
        <button onclick="sendQuickMessage('Aku merasa lelah')" class="quick-chip">😴 Lelah</button>
        <button onclick="sendQuickMessage('Aku merasa sedih')" class="quick-chip">😢 Sedih</button>
        <button onclick="sendQuickMessage('Aku merasa senang')" class="quick-chip">😊 Senang</button>
        <button onclick="sendQuickMessage('Butuh motivasi')" class="quick-chip">💪 Motivasi</button>
      </div>

      <!-- Chat Messages -->
      <div id="widget-chat-messages" class="flex-1 overflow-y-auto p-3 space-y-3" style="height: calc(100% - 145px)">
        <!-- Welcome message -->
        <div class="flex justify-start animate-fade-in">
          <div class="flex gap-2 max-w-[85%]">
            <div class="w-6 h-6 rounded-full gradient-accent flex items-center justify-center flex-shrink-0 mt-1">
              <i data-lucide="bot" class="w-3 h-3 text-white"></i>
            </div>
            <div class="widget-bubble-ai">
              <p class="text-sm">Hai! 👋 Aku HAPI Buddy, teman curhatmu. Ceritakan apa yang kamu rasakan, atau pilih topik di atas.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Chat Input -->
      <div class="px-3 py-2.5 border-t border-surface-700/50 bg-surface-900/50 backdrop-blur-xl">
        <form id="widget-chat-form" class="flex gap-2">
          <input type="text" id="widget-chat-input" data-i18n-placeholder="chat.placeholder" placeholder="Ceritakan perasaanmu..." class="flex-1 px-3 py-2 bg-surface-800/70 border border-surface-600/50 rounded-xl text-sm text-surface-100 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all" autocomplete="off">
          <button type="submit" class="p-2 rounded-xl bg-brand-600 text-white hover:bg-brand-500 transition-all active:scale-95 shadow-lg shadow-brand-600/25" id="widget-send-btn">
            <i data-lucide="send" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Floating Action Button -->
  <button id="chatbot-fab" onclick="toggleChatbot()" class="relative group">
    <div class="w-14 h-14 rounded-full gradient-accent flex items-center justify-center shadow-xl shadow-accent-purple/30 hover:shadow-2xl hover:shadow-accent-purple/40 transition-all duration-300 hover:scale-110 active:scale-95">
      <i data-lucide="message-circle-heart" class="w-6 h-6 text-white chatbot-icon-open"></i>
      <i data-lucide="x" class="w-6 h-6 text-white chatbot-icon-close hidden"></i>
    </div>
    <!-- Pulse ring -->
    <div class="absolute inset-0 rounded-full gradient-accent opacity-30 animate-ping pointer-events-none" id="chatbot-ping"></div>
    <!-- Notification badge -->
    <div class="absolute -top-1 -right-1 w-5 h-5 bg-danger-500 rounded-full flex items-center justify-center text-[10px] text-white font-bold shadow-lg" id="chatbot-badge" style="display: none">1</div>
    <!-- Tooltip -->
    <div class="absolute bottom-full right-0 mb-2 px-3 py-1.5 bg-surface-800 rounded-lg text-xs text-surface-200 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none border border-surface-700/50 shadow-lg">
      💬 Butuh curhat?
    </div>
  </button>
</div>

<script>
// Chatbot Widget Logic
let chatbotOpen = false;

function toggleChatbot() {
  chatbotOpen = !chatbotOpen;
  const window = document.getElementById('chatbot-window');
  const iconOpen = document.querySelector('.chatbot-icon-open');
  const iconClose = document.querySelector('.chatbot-icon-close');
  const ping = document.getElementById('chatbot-ping');
  const badge = document.getElementById('chatbot-badge');
  
  if (chatbotOpen) {
    window.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    ping?.classList.add('hidden');
    if (badge) badge.style.display = 'none';
    document.getElementById('widget-chat-input')?.focus();
    // Scroll to bottom
    const msgs = document.getElementById('widget-chat-messages');
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  } else {
    window.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }
  lucide.createIcons();
}

function sendQuickMessage(msg) {
  const input = document.getElementById('widget-chat-input');
  if (input) {
    input.value = msg;
    document.getElementById('widget-chat-form')?.dispatchEvent(new Event('submit'));
  }
}

function appendWidgetMessage(role, text) {
  const container = document.getElementById('widget-chat-messages');
  if (!container) return;

  const div = document.createElement('div');
  div.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'} animate-fade-in`;

  if (role === 'ai') {
    div.innerHTML = `<div class="flex gap-2 max-w-[85%]"><div class="w-6 h-6 rounded-full gradient-accent flex items-center justify-center flex-shrink-0 mt-1"><i data-lucide="bot" class="w-3 h-3 text-white"></i></div><div class="widget-bubble-ai"><p class="text-sm">${text}</p></div></div>`;
  } else {
    div.innerHTML = `<div class="widget-bubble-user"><p class="text-sm">${text}</p></div>`;
  }

  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  lucide.createIcons();
}

function showWidgetTyping() {
  const container = document.getElementById('widget-chat-messages');
  if (!container) return null;

  const id = 'widget-typing-' + Date.now();
  const div = document.createElement('div');
  div.id = id;
  div.className = 'flex justify-start animate-fade-in';
  div.innerHTML = `<div class="flex gap-2"><div class="w-6 h-6 rounded-full gradient-accent flex items-center justify-center flex-shrink-0 mt-1"><i data-lucide="bot" class="w-3 h-3 text-white"></i></div><div class="widget-bubble-ai"><div class="flex gap-1.5 items-center py-1"><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0s"></span><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0.15s"></span><span class="w-2 h-2 bg-surface-400 rounded-full animate-bounce" style="animation-delay:0.3s"></span></div></div></div>`;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  lucide.createIcons();
  return id;
}

// Chat form submit
document.getElementById('widget-chat-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const input = document.getElementById('widget-chat-input');
  const msg = input?.value.trim();
  if (!msg) return;

  appendWidgetMessage('user', msg);
  input.value = '';

  // Hide quick actions after first message
  const qa = document.getElementById('chatbot-quick-actions');
  if (qa) qa.style.display = 'none';

  const typingId = showWidgetTyping();

  try {
    const res = await axios.post('/api/chat', { message: msg });
    if (typingId) document.getElementById(typingId)?.remove();
    if (res.data.success) {
      appendWidgetMessage('ai', res.data.response);
    } else {
      appendWidgetMessage('ai', 'Maaf, terjadi kesalahan. Coba lagi ya.');
    }
  } catch(err) {
    if (typingId) document.getElementById(typingId)?.remove();
    appendWidgetMessage('ai', 'Maaf, terjadi kesalahan koneksi. Coba lagi ya.');
  }
});

async function clearWidgetChat() {
  if (!confirm('Hapus semua riwayat chat?')) return;
  try {
    await axios.delete('/api/chat');
    const container = document.getElementById('widget-chat-messages');
    if (container) {
      container.innerHTML = `<div class="flex justify-start animate-fade-in"><div class="flex gap-2 max-w-[85%]"><div class="w-6 h-6 rounded-full gradient-accent flex items-center justify-center flex-shrink-0 mt-1"><i data-lucide="bot" class="w-3 h-3 text-white"></i></div><div class="widget-bubble-ai"><p class="text-sm">Chat sudah dibersihkan! ✨ Apa yang ingin kamu ceritakan?</p></div></div></div>`;
      lucide.createIcons();
    }
    const qa = document.getElementById('chatbot-quick-actions');
    if (qa) qa.style.display = '';
  } catch(err) {
    // Silently fail
  }
}

// Auto show badge after 10 seconds if not opened
setTimeout(() => {
  if (!chatbotOpen) {
    const badge = document.getElementById('chatbot-badge');
    if (badge) badge.style.display = 'flex';
  }
}, 10000);
</script>
