<div id="global-mood-overlay" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="glass-card p-8 w-full max-w-md mx-4 animate-scale-in border border-surface-600/40 shadow-2xl shadow-black/30">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl gradient-accent flex items-center justify-center shadow-lg shadow-accent-purple/20">
          <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold font-display text-surface-50" >Bagaimana Perasaanmu?</h3>
          <p class="text-xs text-surface-400" >Catat moodmu saat ini</p>
        </div>
      </div>
      <button onclick="closeGlobalMood()" class="p-2 rounded-lg hover:bg-surface-700/50 text-surface-400 hover:text-surface-200 transition-colors" id="btn-close-mood">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="global-mood-form" class="space-y-5">
      <div>
        <label class="input-label text-xs" >Pilih Mood</label>
        <div class="flex justify-between gap-2" id="global-mood-selector">
          <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border-2 border-transparent global-mood-btn transition-all duration-200 hover:scale-105" data-score="1" data-label-id="Sangat Buruk" data-label-en="Very Bad">
            <div class="text-3xl mb-1">😞</div>
            <div class="text-[10px] text-surface-400 mood-label" >Sangat Buruk</div>
          </button>
          <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border-2 border-transparent global-mood-btn transition-all duration-200 hover:scale-105" data-score="2" data-label-id="Buruk" data-label-en="Bad">
            <div class="text-3xl mb-1">😕</div>
            <div class="text-[10px] text-surface-400 mood-label" >Buruk</div>
          </button>
          <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border-2 border-transparent global-mood-btn transition-all duration-200 hover:scale-105" data-score="3" data-label-id="Biasa" data-label-en="Okay">
            <div class="text-3xl mb-1">😐</div>
            <div class="text-[10px] text-surface-400 mood-label" >Biasa</div>
          </button>
          <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border-2 border-transparent global-mood-btn transition-all duration-200 hover:scale-105" data-score="4" data-label-id="Baik" data-label-en="Good">
            <div class="text-3xl mb-1">😊</div>
            <div class="text-[10px] text-surface-400 mood-label" >Baik</div>
          </button>
          <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border-2 border-transparent global-mood-btn transition-all duration-200 hover:scale-105" data-score="5" data-label-id="Sangat Baik" data-label-en="Great">
            <div class="text-3xl mb-1">😄</div>
            <div class="text-[10px] text-surface-400 mood-label" >Sangat Baik</div>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="input-label text-xs flex items-center gap-1.5">
            <i data-lucide="zap" class="w-3.5 h-3.5 text-warning-400"></i>
            <span >Energi</span>
            <span class="ml-auto text-surface-400 font-mono" id="global-energy-val">3</span>
          </label>
          <input type="range" min="1" max="5" value="3" class="w-full accent-warning-400 range-slider" name="energy_level" id="global-energy-slider" oninput="document.getElementById('global-energy-val').textContent=this.value">
          <div class="flex justify-between text-[9px] text-surface-500 mt-1">
            <span >Rendah</span><span >Tinggi</span>
          </div>
        </div>
        <div>
          <label class="input-label text-xs flex items-center gap-1.5">
            <i data-lucide="flame" class="w-3.5 h-3.5 text-danger-400"></i>
            <span >Stres</span>
            <span class="ml-auto text-surface-400 font-mono" id="global-stress-val">3</span>
          </label>
          <input type="range" min="1" max="5" value="3" class="w-full accent-danger-400 range-slider" name="stress_level" id="global-stress-slider" oninput="document.getElementById('global-stress-val').textContent=this.value">
          <div class="flex justify-between text-[9px] text-surface-500 mt-1">
            <span >Rendah</span><span >Tinggi</span>
          </div>
        </div>
      </div>

      <div>
        <label class="input-label text-xs"><span >Catatan</span> <span class="text-surface-500" >(opsional)</span></label>
        <textarea name="notes" rows="2" class="input-field resize-none text-sm" id="global-mood-notes" placeholder="Apa yang mempengaruhi moodmu hari ini?"></textarea>
      </div>

      <button type="submit" class="btn-primary w-full group" id="btn-save-global-mood">
        <i data-lucide="check-circle" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
        <span >Simpan Mood</span>
      </button>
    </form>

    <p class="text-[10px] text-surface-500 text-center mt-3" >Tracking mood membantumu memahami pola emosimu</p>
  </div>
</div>

<script>
let globalSelectedMood = null;
const __moodLoggedToday = ('<%= typeof moodLoggedToday !== "undefined" ? moodLoggedToday : false %>' === 'true');

function openGlobalMood() {
  if (__moodLoggedToday) {
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    Swal.fire({
      title: 'Sudah Tercatat!',
      text: 'Kamu sudah mencatat mood hari ini. Coba lagi besok ya!',
      icon: 'info',
      confirmButtonColor: '#A86240',
      background: isDark ? '#1e1611' : '#ffffff',
      color: isDark ? '#f8f4f0' : '#3a1e13',
      backdrop: 'rgba(0,0,0,0.75)',
      position: 'center',
      customClass: { container: 'z-[99999]' }
    });
    return;
  }
  const modal = document.getElementById('global-mood-overlay');
  if (modal) {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
}

function closeGlobalMood() {
  const modal = document.getElementById('global-mood-overlay');
  if (modal) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
  globalSelectedMood = null;
  document.querySelectorAll('.global-mood-btn').forEach(b => {
    b.classList.remove('bg-brand-600/20', 'border-brand-500', 'scale-110');
  });
}

document.getElementById('global-mood-overlay')?.addEventListener('click', (e) => {
  if (e.target.id === 'global-mood-overlay') closeGlobalMood();
});

document.querySelectorAll('.global-mood-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.global-mood-btn').forEach(b => {
      b.classList.remove('bg-brand-600/20', 'border-brand-500', 'scale-110');
    });
    btn.classList.add('bg-brand-600/20', 'border-brand-500', 'scale-110');
    globalSelectedMood = {
      score: parseInt(btn.dataset.score),
      label: btn.dataset.labelId,
    };
  });
});

document.getElementById('global-mood-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!globalSelectedMood) {
    const msg = 'Pilih mood terlebih dahulu.';
    window.showToast?.(msg, 'warning');
    return;
  }

  const data = {
    mood_score: globalSelectedMood.score,
    mood_label: globalSelectedMood.label,
    energy_level: parseInt(document.getElementById('global-energy-slider')?.value || 3),
    stress_level: parseInt(document.getElementById('global-stress-slider')?.value || 3),
    notes: document.getElementById('global-mood-notes')?.value || '',
  };

  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';

  try {
    const res = await fetch('/api/mood', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const resData = await res.json();

    if (res.ok) {
      closeGlobalMood();
      Swal.fire({
        title: 'Mood Tersimpan!',
        text: 'Terima kasih sudah mencatat perasaanmu hari ini.',
        icon: 'success',
        confirmButtonColor: '#A86240',
        background: isDark ? '#1e1611' : '#ffffff',
        color: isDark ? '#f8f4f0' : '#3a1e13',
        backdrop: 'rgba(0,0,0,0.75)',
        position: 'center',
        customClass: { container: 'z-[99999]' }
      }).then(() => {
        if (window.location.pathname === '/dashboard') {
          location.reload();
        }
      });
    } else if (resData.alreadyLogged) {
      closeGlobalMood();
      Swal.fire({
        title: 'Sudah Terisi!',
        text: 'Kamu sudah mencatat mood hari ini. Coba lagi besok ya!',
        icon: 'info',
        confirmButtonColor: '#A86240',
        background: isDark ? '#1e1611' : '#ffffff',
        color: isDark ? '#f8f4f0' : '#3a1e13',
        backdrop: 'rgba(0,0,0,0.75)',
        position: 'center',
        customClass: { container: 'z-[99999]' }
      });
    } else {
      window.showToast?.(resData.error || 'Gagal menyimpan mood.', 'error');
    }
  } catch (err) {
    const msg = 'Gagal menyimpan mood.';
    window.showToast?.(msg, 'error');
  }
});

window.openMoodModal = openGlobalMood;
window.closeMoodModal = closeGlobalMood;
window.openGlobalMood = openGlobalMood;
window.closeGlobalMood = closeGlobalMood;
</script>
