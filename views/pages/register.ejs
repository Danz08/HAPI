<!-- Register Page -->
<div class="min-h-screen flex items-center justify-center px-6 py-12">
  <div class="w-full max-w-md">
    <!-- Back Button -->
    <div class="mb-6 animate-slide-up">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-surface-400 hover:text-surface-200 transition-colors group">
        <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
        Kembali ke Beranda
      </a>
    </div>

    <!-- Logo -->
    <div class="text-center mb-8 animate-slide-up">
      <a href="/" class="inline-flex items-center gap-3 mb-6">
        <div class="w-12 h-12 rounded-xl gradient-brand flex items-center justify-center shadow-lg shadow-brand-600/25">
          <i data-lucide="brain" class="w-6 h-6 text-white"></i>
        </div>
        <span class="text-2xl font-bold font-display text-surface-50">HAPI</span>
      </a>
      <h2 class="text-2xl font-bold font-display text-surface-50">Buat Akun Baru</h2>
      <p class="text-surface-400 mt-2">Mulai perjalanan monitoring fatigue-mu</p>
    </div>

    <!-- Register Form -->
    <div class="glass-card p-8 animate-scale-in">
      <!-- Google Register -->
      <a href="/auth/google" class="flex items-center justify-center gap-3 w-full py-3 px-4 rounded-xl bg-white hover:bg-gray-50 text-gray-700 font-medium text-sm transition-all border border-gray-200 shadow-sm hover:shadow mb-6" id="btn-google-register">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Daftar dengan Google
      </a>

      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-surface-700"></div></div>
        <div class="relative flex justify-center text-xs"><span class="px-3 bg-surface-800 text-surface-400">atau daftar dengan email</span></div>
      </div>

      <form action="/auth/register" method="POST" class="space-y-5">
        <div>
          <label for="display_name" class="input-label">Nama Lengkap</label>
          <input type="text" id="display_name" name="display_name" placeholder="Nama tampilan" required class="input-field">
        </div>

        <div>
          <label for="username" class="input-label">Username</label>
          <input type="text" id="username" name="username" placeholder="username_kamu" required class="input-field" autocomplete="username">
        </div>

        <div>
          <label for="email" class="input-label">Email</label>
          <input type="email" id="email" name="email" placeholder="contoh@email.com" required class="input-field" autocomplete="email">
        </div>

        <div>
          <label for="password" class="input-label">Password</label>
          <input type="password" id="password" name="password" placeholder="Minimal 6 karakter" required minlength="6" class="input-field" autocomplete="new-password">
        </div>

        <div>
          <label for="confirm_password" class="input-label">Konfirmasi Password</label>
          <input type="password" id="confirm_password" name="confirm_password" placeholder="Ulangi password" required class="input-field" autocomplete="new-password">
        </div>

        <button type="submit" class="btn-primary w-full" id="btn-register">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          Buat Akun
        </button>
      </form>

      <div class="mt-6 text-center">
        <p class="text-sm text-surface-400">
          Sudah punya akun?
          <a href="/auth/login" class="text-brand-400 hover:text-brand-300 font-semibold transition-colors">Masuk di sini</a>
        </p>
      </div>
    </div>
  </div>
</div>
