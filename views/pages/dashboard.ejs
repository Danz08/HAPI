<!-- Dashboard Page — Warm Theme -->

<!-- Dashboard Header -->
<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 sm:mb-8">
  <div>
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold font-display text-surface-50 mb-1" >Selamat datang kembali</h1>
    <p class="text-xs sm:text-sm text-surface-400" >Berikut rangkuman metrik kelelahan dan aktivitasmu hari ini.</p>
  </div>
</div>

<% if (typeof showQuizReminder !== 'undefined' && showQuizReminder) { %>
<div class="mb-6 bg-danger-500/10 border border-danger-500/30 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 animate-fade-in" id="quiz-warning-banner" style="display: none;">
  <div class="flex items-start sm:items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-danger-500/20 flex items-center justify-center shrink-0">
      <i data-lucide="alert-circle" class="w-5 h-5 text-danger-400"></i>
    </div>
    <div>
      <h4 class="text-surface-50 font-semibold" >Quiz Belum Diisi!</h4>
      <p class="text-sm text-surface-300" >Kamu belum mengisi quiz hari ini. Streakmu terancam padam jika tidak diisi sebelum berganti hari!</p>
    </div>
  </div>
  <a href="/quiz" class="btn-primary btn-sm shrink-0 whitespace-nowrap"><i data-lucide="edit-3" class="w-4 h-4 mr-2"></i> <span >Isi Quiz Sekarang</span></a>
</div>
<% } %>

<!-- Top Row: Current Risk + 7-Day Fatigue Trend -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">

  <!-- Current Risk Card -->
  <div class="glass-card p-4 sm:p-6 flex flex-col items-center text-center glow-<%= fatigueData.riskLevel === 'Low' ? 'success' : fatigueData.riskLevel === 'High' ? 'danger' : 'warning' %>">
    <h3 class="text-base sm:text-lg font-bold font-display text-surface-50 mb-4 sm:mb-5 self-start" >Skor Risiko Saat Ini</h3>

    <!-- Circular Gauge -->
    <div class="relative mb-4">
      <svg width="140" height="140" viewBox="0 0 160 160" class="md:w-[160px] md:h-[160px]">
        <circle cx="80" cy="80" r="70" fill="none" stroke="rgba(62,45,34,0.15)" stroke-width="10"/>
        <%
          const score = fatigueData.score;
          const circumference = 2 * Math.PI * 70;
          const dashOffset = circumference - (score / 100) * circumference;
          const gaugeColor = fatigueData.riskLevel === 'Low' ? '#22c55e' : fatigueData.riskLevel === 'High' ? '#ef4444' : '#A86240';
        %>
        <circle cx="80" cy="80" r="70" fill="none"
                stroke="<%= gaugeColor %>" stroke-width="10"
                stroke-dasharray="<%= circumference %>"
                stroke-dashoffset="<%= dashOffset %>"
                stroke-linecap="round"
                transform="rotate(-90 80 80)"
                style="transition: stroke-dashoffset 1s ease-out"/>
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="text-4xl font-bold font-display" <%- `style="color:${gaugeColor};"` %>><%= score %></span>
        <span class="text-xs font-semibold uppercase tracking-wider mt-1" <%- `style="color:${gaugeColor};"` %>><%= riskColor.label %></span>
      </div>
    </div>

    <p class="text-sm text-surface-400 leading-relaxed max-w-xs">
      <% if (fatigueData.riskLevel === 'Low') { %>
        <span >Tingkat kelelahanmu masih dalam batas wajar. Pertahankan ritme baikmu!</span>
      <% } else if (fatigueData.riskLevel === 'High') { %>
        <span >Tingkat kelelahanmu tinggi. Segera istirahat dan kurangi beban kerja.</span>
      <% } else { %>
        <span >Kelelahanmu mulai meningkat. Pertimbangkan istirahat singkat.</span>
      <% } %>
    </p>
    <p class="text-[10px] text-surface-500 mt-3"><span >Terakhir diperbarui</span>: <span class="live-time-display">--:--</span></p>
  </div>

  <!-- 7-Day Fatigue Trend -->
  <div class="glass-card p-4 sm:p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold font-display text-surface-50" >Tren Kelelahan 7 Hari</h3>
      <a href="/analytics" class="text-xs font-semibold text-brand-500 hover:text-brand-400 transition-colors" >Lihat Detail →</a>
    </div>
    <div class="h-56"><canvas id="activityChart"></canvas></div>
  </div>
</div>

<script type="application/json" id="chart-data-json">
<%- JSON.stringify({
  recentActivities: recentActivities,
  moodTrend: moodTrend.slice(0, 7).reverse(),
  fatigueScore: fatigueData.score
}) %>
</script>
<script>
  window.__chartData = JSON.parse(document.getElementById('chart-data-json').textContent);
</script>

<!-- Bottom Row: Today's Activity + Insights + Mood History -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-4 sm:mb-6">

  <!-- Today's Activity -->
  <div class="glass-card p-4 sm:p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-5" >Aktivitas Hari Ini</h3>
    <div class="space-y-4">
      <a href="/pomodoro" class="flex items-center justify-between p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700/50 transition-all group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-brand-500/15 flex items-center justify-center group-hover:scale-110 transition-transform">
            <i data-lucide="timer" class="w-4 h-4 text-brand-500"></i>
          </div>
          <span class="text-sm font-medium text-surface-200" >Sesi Pomodoro</span>
        </div>
        <span class="text-lg font-bold font-display text-surface-50"><%= pomodoroToday.total_cycles %></span>
      </a>

      <a href="/quiz" class="flex items-center justify-between p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700/50 transition-all group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-accent-purple/15 flex items-center justify-center group-hover:scale-110 transition-transform">
            <i data-lucide="clipboard-check" class="w-4 h-4 text-accent-purple"></i>
          </div>
          <span class="text-sm font-medium text-surface-200" >Quiz Diambil</span>
        </div>
        <span class="text-lg font-bold font-display text-surface-50"><%= todayQuizCount %></span>
      </a>

      <a href="/analytics" class="flex items-center justify-between p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700/50 transition-all group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-accent-teal/15 flex items-center justify-center group-hover:scale-110 transition-transform">
            <i data-lucide="bar-chart-3" class="w-4 h-4 text-accent-teal"></i>
          </div>
          <span class="text-sm font-medium text-surface-200" >Analitik</span>
        </div>
        <span class="text-lg font-bold font-display text-surface-50"><%= todayStats.session_count %></span>
      </a>
    </div>
  </div>

  <!-- Insights -->
  <div class="glass-card p-4 sm:p-6">
    <div class="flex items-center gap-2 mb-5">
      <i data-lucide="lightbulb" class="w-5 h-5 text-warning-400"></i>
      <h3 class="text-lg font-bold font-display text-surface-50" >Wawasan</h3>
    </div>
    <div class="space-y-4">
      <% recommendations.insights.forEach(function(ins, idx) { %>
      <div class="p-3 rounded-xl bg-surface-800/50 border-l-2 border-brand-500/50">
        <p class="text-sm text-surface-200 leading-relaxed mb-2 insight-desc" data-desc-id="<%= ins.description %>" data-desc-en="<%= ins.description_en || ins.description %>"><%= ins.description %></p>
      </div>
      <% }) %>
      <div class="p-3 rounded-xl bg-accent-teal/5 border border-accent-teal/20">
        <p class="text-sm text-surface-200 leading-relaxed mb-2 insight-desc" data-desc-id="<%= recommendations.moodTip %>" data-desc-en="<%= recommendations.moodTip_en || recommendations.moodTip %>"><%= recommendations.moodTip %></p>
        <button onclick="toggleChatbot()" class="text-xs font-semibold text-accent-teal hover:underline" >Mulai Obrolan</button>
      </div>
    </div>
  </div>

  <!-- Mood History -->
  <div class="glass-card p-4 sm:p-6">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold font-display text-surface-50" >Riwayat Mood</h3>
      <button onclick="openGlobalMood()" class="text-surface-400 hover:text-surface-200 transition-colors">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
      </button>
    </div>
    <% if (moodTrend && moodTrend.length > 0) { %>
    <div class="space-y-4">
      <% moodTrend.slice().reverse().slice(0, 7).forEach(function(entry) { %>
      <div class="border-b border-surface-700/30 pb-3 last:border-0 last:pb-0">
        <p class="text-[10px] text-surface-500 mb-1"><%= entry.log_date %>, <%= entry.log_time ? entry.log_time.substring(0,5) : '' %></p>
        <p class="text-sm text-surface-200 leading-relaxed">
          <span><%= entry.mood_label %></span> — <span >Energi</span>: <%= entry.energy_level %>/5, <span >Stres</span>: <%= entry.stress_level %>/5
        </p>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-8">
      <i data-lucide="smile" class="w-8 h-8 text-surface-500 mx-auto mb-2"></i>
      <p class="text-sm text-surface-400" >Belum ada catatan mood.</p>
      <button onclick="openGlobalMood()" class="text-xs text-brand-500 hover:underline mt-1 inline-block" >Mulai catat →</button>
    </div>
    <% } %>
  </div>
</div>

<!-- AI Predictions Row (ML Model API) -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
  <!-- Burnout Prediction Card -->
  <div class="glass-card p-4 sm:p-6 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 rounded-full bg-gradient-to-br from-danger-500/10 to-warning-400/5 blur-2xl -mr-8 -mt-8"></div>
    <div class="relative">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-danger-500/20 to-warning-400/20 flex items-center justify-center">
          <i data-lucide="flame" class="w-5 h-5 text-danger-400"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold font-display text-surface-50">Prediksi Burnout</h3>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-accent-purple/15 text-accent-purple">
            <i data-lucide="cpu" class="w-3 h-3"></i> AI Model
          </span>
        </div>
      </div>

      <% if (mlBurnout) { %>
        <%
          const burnoutScore = typeof mlBurnout.burnout_score === 'number' ? mlBurnout.burnout_score : 0;
          const burnoutPct = Math.min(100, Math.max(0, Math.round(burnoutScore)));
          const burnoutColor = burnoutPct <= 33 ? '#22c55e' : burnoutPct <= 66 ? '#f59e0b' : '#ef4444';
          const burnoutLabel = burnoutPct <= 33 ? 'Rendah' : burnoutPct <= 66 ? 'Sedang' : 'Tinggi';
          const burnoutDesc = burnoutPct <= 33 ? 'Tingkat burnout masih rendah. Pertahankan keseimbangan aktivitasmu!' : burnoutPct <= 66 ? 'Ada indikasi burnout sedang. Perhatikan pola istirahat dan beban kerja.' : 'Tingkat burnout tinggi. Segera kurangi beban dan prioritaskan istirahat.';
        %>
        <div class="flex items-center gap-6">
          <div class="relative">
            <svg width="100" height="100" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(62,45,34,0.15)" stroke-width="8"/>
              <%
                const bCirc = 2 * Math.PI * 42;
                const bOffset = bCirc - (burnoutPct / 100) * bCirc;
              %>
              <circle cx="50" cy="50" r="42" fill="none"
                      stroke="<%= burnoutColor %>" stroke-width="8"
                      stroke-dasharray="<%= bCirc %>"
                      stroke-dashoffset="<%= bOffset %>"
                      stroke-linecap="round"
                      transform="rotate(-90 50 50)"
                      style="transition: stroke-dashoffset 1s ease-out"/>
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-2xl font-bold font-display" style="color: <%= burnoutColor %>"><%= burnoutPct %></span>
              <span class="text-[9px] text-surface-400">/ 100</span>
            </div>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-sm font-bold text-surface-100"><%= burnoutLabel %></span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold" style="background: <%= burnoutColor %>20; color: <%= burnoutColor %>">
                Score: <%= burnoutScore.toFixed(2) %>
              </span>
            </div>
            <p class="text-xs text-surface-400 leading-relaxed"><%= burnoutDesc %></p>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-4">
          <i data-lucide="cloud-off" class="w-6 h-6 text-surface-500 mx-auto mb-2"></i>
          <p class="text-xs text-surface-400">Data prediksi belum tersedia. Isi quiz dan catat aktivitasmu untuk mendapatkan prediksi burnout AI.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Lifestyle Stress Level Card -->
  <div class="glass-card p-4 sm:p-6 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 rounded-full bg-gradient-to-br from-accent-teal/10 to-success-500/5 blur-2xl -mr-8 -mt-8"></div>
    <div class="relative">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-accent-teal/20 to-success-500/20 flex items-center justify-center">
          <i data-lucide="activity" class="w-5 h-5 text-accent-teal"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold font-display text-surface-50">Analisis Gaya Hidup</h3>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-accent-purple/15 text-accent-purple">
            <i data-lucide="cpu" class="w-3 h-3"></i> AI Model
          </span>
        </div>
      </div>

      <% if (mlLifestyle) { %>
        <%
          const stressLevel = mlLifestyle.stress_level || 'Unknown';
          const stressConf = typeof mlLifestyle.confidence === 'number' ? mlLifestyle.confidence : 0;
          const stressColors = { Low: '#22c55e', Medium: '#f59e0b', High: '#ef4444' };
          const stressColor = stressColors[stressLevel] || '#A86240';
          const stressEmojis = { Low: '😊', Medium: '😐', High: '😰' };
          const stressEmoji = stressEmojis[stressLevel] || '📊';
          const stressLabels = { Low: 'Stres Rendah', Medium: 'Stres Sedang', High: 'Stres Tinggi' };
          const stressLabel = stressLabels[stressLevel] || stressLevel;
          const stressDescs = {
            Low: 'Gaya hidupmu saat ini tergolong sehat. Pola aktivitas, istirahat, dan mood menunjukkan keseimbangan yang baik.',
            Medium: 'Ada beberapa aspek gaya hidupmu yang perlu diperhatikan. Pertimbangkan untuk menyeimbangkan kerja dan istirahat.',
            High: 'Gaya hidupmu menunjukkan tingkat stres tinggi. Evaluasi kembali pola kerja, tidur, dan aktivitas harianmu.'
          };
          const stressDesc = stressDescs[stressLevel] || 'Data analisis gaya hidup berdasarkan pola aktivitasmu.';
        %>
        <div class="flex items-center gap-6">
          <div class="text-center flex-shrink-0">
            <div class="text-5xl mb-2"><%= stressEmoji %></div>
            <div class="px-3 py-1.5 rounded-xl text-sm font-bold" style="background: <%= stressColor %>15; color: <%= stressColor %>; border: 1px solid <%= stressColor %>30">
              <%= stressLabel %>
            </div>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs text-surface-400">Kepercayaan AI:</span>
              <div class="flex-1 h-1.5 bg-surface-700 rounded-full overflow-hidden">
                <div class="h-full rounded-full" style="width: <%= Math.round(stressConf * 100) %>%; background: <%= stressColor %>"></div>
              </div>
              <span class="text-xs font-bold font-mono" style="color: <%= stressColor %>"><%= Math.round(stressConf * 100) %>%</span>
            </div>
            <p class="text-xs text-surface-400 leading-relaxed"><%= stressDesc %></p>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-4">
          <i data-lucide="cloud-off" class="w-6 h-6 text-surface-500 mx-auto mb-2"></i>
          <p class="text-xs text-surface-400">Data analisis gaya hidup belum tersedia. Catat mood dan aktivitasmu secara rutin untuk mendapatkan analisis AI.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Fatigue Breakdown + Quick Actions Row -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-4 sm:mb-6">
  <!-- Fatigue Breakdown -->
  <div class="lg:col-span-2 glass-card p-4 sm:p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
      <i data-lucide="pie-chart" class="w-5 h-5 inline text-warning-400 mr-2"></i>Rincian Kelelahan
    </h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% const bl = { quiz: 'Quiz', mood: 'Mood', workload: 'Beban Kerja', breaks: 'Istirahat' }; %>
      <% for (const [k,l] of Object.entries(bl)) { %>
      <div class="text-center p-4 rounded-xl bg-surface-800/50">
        <div class="text-2xl font-bold font-display text-surface-50"><%= fatigueData.breakdown[k] %>%</div>
        <div class="text-xs text-surface-400 mt-1"><%= l %></div>
        <div class="mt-2 h-1.5 bg-surface-700 rounded-full overflow-hidden">
          <div class="h-full rounded-full gradient-brand" <%- `style="width:${fatigueData.breakdown[k]}%;"` %>></div>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Log Activity -->
  <div class="glass-card p-4 sm:p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
      <i data-lucide="plus-circle" class="w-5 h-5 inline text-success-400 mr-1"></i>Catat Aktivitas
    </h3>
    <form id="activity-form" class="space-y-3">
      <select name="activity_type" class="input-field text-sm">
        <option value="work" >Kerja</option>
        <option value="study" >Belajar</option>
        <option value="meeting" >Rapat</option>
        <option value="other" >Lainnya</option>
      </select>
      <input type="text" name="description" placeholder="Deskripsi kegiatan..." class="input-field text-sm">
      <div class="grid grid-cols-2 gap-3">
        <input type="number" name="duration_minutes" min="0" value="25" class="input-field text-sm" placeholder="Durasi (mnt)">
        <input type="number" name="break_minutes" min="0" value="5" class="input-field text-sm" placeholder="Istirahat (mnt)">
      </div>
      <button type="submit" class="btn-success w-full btn-sm"><i data-lucide="check" class="w-4 h-4"></i> <span >Simpan</span></button>
    </form>
  </div>
</div>

<!-- Disclaimer -->
<div class="glass-card p-4 text-center">
  <p class="text-[10px] text-surface-500 leading-relaxed" >HAPI dirancang untuk memberikan wawasan seputar kelelahan. Ini bukan pengganti saran medis profesional. Selalu konsultasikan dengan dokter atau tenaga kesehatan profesional untuk pertanyaan medis.</p>
</div>

<!-- Mood Modal -->
<div id="mood-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="glass-card p-8 w-full max-w-md mx-4 animate-scale-in">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold font-display text-surface-50" >Bagaimana Perasaanmu?</h3>
      <button onclick="closeMoodModal()" class="text-surface-400 hover:text-surface-200"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <form id="mood-form" class="space-y-6">
      <div class="flex justify-between gap-2" id="mood-selector">
        <% [{s:1,e:'😞',l:'Sangat Buruk'},{s:2,e:'😕',l:'Buruk'},{s:3,e:'😐',l:'Biasa'},{s:4,e:'😊',l:'Baik'},{s:5,e:'😄',l:'Sangat Baik'}].forEach(function(m){ %>
        <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border border-transparent mood-btn" data-score="<%= m.s %>" data-label="<%= m.l %>">
          <div class="text-2xl"><%= m.e %></div><div class="text-[10px] text-surface-400 mt-1"><%= m.l %></div>
        </button>
        <% }) %>
      </div>
      <div><label class="input-label" >Tingkat Energi</label><input type="range" min="1" max="5" value="3" class="w-full accent-brand-500" name="energy_level" id="energy-slider"></div>
      <div><label class="input-label" >Tingkat Stres</label><input type="range" min="1" max="5" value="3" class="w-full accent-danger-500" name="stress_level" id="stress-slider"></div>
      <textarea name="notes" rows="2" placeholder="Ada yang ingin diceritakan? (opsional)" class="input-field resize-none" id="mood-notes"></textarea>
      <button type="submit" class="btn-primary w-full"><i data-lucide="save" class="w-4 h-4"></i> <span >Simpan Mood</span></button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const isDarkMode = document.documentElement.getAttribute('data-theme') !== 'light';
    const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
    
    const dayNames = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
    const todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: userTz }).format(new Date());
    
    const showMoodReminderFlag = ('<%= showMoodReminder %>' === 'true') && (localStorage.getItem('moodReminderSeenDate') !== todayStr);
    const showQuizReminderFlag = ('<%= typeof showQuizReminder !== "undefined" ? showQuizReminder : false %>' === 'true') && (localStorage.getItem('quizReminderSeenDate') !== todayStr);

    const checkQuizReminder = () => {
      const banner = document.getElementById('quiz-warning-banner');
      if (showQuizReminderFlag) {
        localStorage.setItem('quizReminderSeenDate', todayStr);
        Swal.fire({
          title: 'Jangan lupa isi Quiz hari ini!',
          text: 'Isi quiz sekarang untuk melihat tingkat kelelahanmu dan menjaga streak tetap menyala!',
          icon: 'info',
          showCancelButton: true,
          confirmButtonText: 'Mulai Quiz',
          cancelButtonText: 'Nanti Saja',
          confirmButtonColor: '#A86240',
          cancelButtonColor: '#489A98',
          background: isDarkMode ? '#1e1611' : '#ffffff',
          color: isDarkMode ? '#f8f4f0' : '#3a1e13',
          backdrop: 'rgba(0,0,0,0.75)',
          position: 'center',
          customClass: {
            container: 'z-[99999]'
          }
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = '/quiz';
          } else {
            if (banner) banner.style.display = 'flex';
          }
        });
      } else if ('<%= typeof showQuizReminder !== "undefined" ? showQuizReminder : false %>' === 'true') {
        if (banner) banner.style.display = 'flex';
      }
    };

    if (showMoodReminderFlag) {
      localStorage.setItem('moodReminderSeenDate', todayStr);
      Swal.fire({
        title: 'Bagaimana perasaanmu hari ini?',
        text: 'Kamu belum mencatat mood hari ini. Catat sekarang untuk menjaga streakmu!',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Catat Mood Sekarang',
        cancelButtonText: 'Nanti Saja',
        confirmButtonColor: '#A86240',
        cancelButtonColor: '#489A98',
        background: isDarkMode ? '#1e1611' : '#ffffff',
        color: isDarkMode ? '#f8f4f0' : '#3a1e13',
        backdrop: 'rgba(0,0,0,0.75)',
        position: 'center',
        customClass: {
          container: 'z-[99999]'
        }
      }).then((result) => {
        if (result.isConfirmed) {
          openGlobalMood();
        } else {
          checkQuizReminder();
        }
      });
    } else {
      checkQuizReminder();
    }
  });
</script>
