<!-- Dashboard Page — Warm Theme -->

<!-- Dashboard Header -->
<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8">
  <div>
    <h1 class="text-3xl md:text-4xl font-bold font-display text-surface-50 mb-1" ><%= t('dashboard.greeting', 'Selamat datang kembali') %></h1>
    <p class="text-sm text-surface-400" ><%= t('dashboard.subtitle', 'Berikut rangkuman metrik kelelahan dan aktivitasmu hari ini.') %></p>
  </div>
</div>

<% if (typeof showQuizReminder !== 'undefined' && showQuizReminder) { %>
<div class="mb-6 bg-danger-500/10 border border-danger-500/30 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 animate-fade-in" id="quiz-warning-banner" style="display: none;">
  <div class="flex items-start sm:items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-danger-500/20 flex items-center justify-center shrink-0">
      <i data-lucide="alert-circle" class="w-5 h-5 text-danger-400"></i>
    </div>
    <div>
      <h4 class="text-surface-50 font-semibold" ><%= t('dashboard.quizWarningTitle', 'Quiz Belum Diisi!') %></h4>
      <p class="text-sm text-surface-300" ><%= t('dashboard.quizWarningDesc', 'Kamu belum mengisi quiz hari ini. Streakmu terancam padam jika tidak diisi sebelum berganti hari!') %></p>
    </div>
  </div>
  <a href="/quiz" class="btn-primary btn-sm shrink-0 whitespace-nowrap"><i data-lucide="edit-3" class="w-4 h-4 mr-2"></i> <span ><%= t('dashboard.fillQuizNow', 'Isi Quiz Sekarang') %></span></a>
</div>
<% } %>

<!-- Top Row: Current Risk + 7-Day Fatigue Trend -->
<div class="grid lg:grid-cols-2 gap-6 mb-6">

  <!-- Current Risk Card -->
  <div class="glass-card p-6 flex flex-col items-center text-center glow-<%= fatigueData.riskLevel === 'Low' ? 'success' : fatigueData.riskLevel === 'High' ? 'danger' : 'warning' %>">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-5 self-start" ><%= t('dashboard.currentRisk', 'Skor Risiko Saat Ini') %></h3>

    <!-- Circular Gauge -->
    <div class="relative mb-4">
      <svg width="140" height="140" viewBox="0 0 160 160" class="md:w-[160px] md:h-[160px]">
        <circle cx="80" cy="80" r="70" fill="none" stroke="rgba(62,45,34,0.15)" stroke-width="10"/>
        <%
          const score = fatigueData.score;
          const circumference = 2 * Math.PI * 70;
          const dashOffset = circumference - (score / 100) * circumference;
          const gaugeColor = fatigueData.riskLevel === 'Low' ? '#22c55e' : fatigueData.riskLevel === 'High' ? '#ef4444' : '#A86240';
        %>
        <circle cx="80" cy="80" r="70" fill="none"
                stroke="<%= gaugeColor %>" stroke-width="10"
                stroke-dasharray="<%= circumference %>"
                stroke-dashoffset="<%= dashOffset %>"
                stroke-linecap="round"
                transform="rotate(-90 80 80)"
                style="transition: stroke-dashoffset 1s ease-out"/>
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="text-4xl font-bold font-display" <%- `style="color:${gaugeColor};"` %>><%= score %></span>
        <span class="text-xs font-semibold uppercase tracking-wider mt-1" <%- `style="color:${gaugeColor};"` %>><%= riskColor.label %></span>
      </div>
    </div>

    <p class="text-sm text-surface-400 leading-relaxed max-w-xs">
      <% if (fatigueData.riskLevel === 'Low') { %>
        <span ><%= t('dashboard.fatigueRiskLow', 'Tingkat kelelahanmu masih dalam batas wajar. Pertahankan ritme baikmu!') %></span>
      <% } else if (fatigueData.riskLevel === 'High') { %>
        <span ><%= t('dashboard.fatigueRiskHigh', 'Tingkat kelelahanmu tinggi. Segera istirahat dan kurangi beban kerja.') %></span>
      <% } else { %>
        <span ><%= t('dashboard.fatigueRiskMed', 'Kelelahanmu mulai meningkat. Pertimbangkan istirahat singkat.') %></span>
      <% } %>
    </p>
    <p class="text-[10px] text-surface-500 mt-3"><span ><%= t('dashboard.lastUpdated', 'Terakhir diperbarui') %></span>: <span class="live-time-display">--:--</span></p>
  </div>

  <!-- 7-Day Fatigue Trend -->
  <div class="glass-card p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold font-display text-surface-50" ><%= t('dashboard.fatigueTrend', 'Tren Kelelahan 7 Hari') %></h3>
      <a href="/analytics" class="text-xs font-semibold text-brand-500 hover:text-brand-400 transition-colors" ><%= t('dashboard.detailedView', 'Lihat Detail →') %></a>
    </div>
    <div class="h-56"><canvas id="activityChart"></canvas></div>
  </div>
</div>

<script type="application/json" id="chart-data-json">
<%- JSON.stringify({
  recentActivities: recentActivities,
  moodTrend: moodTrend.slice(0, 7).reverse(),
  fatigueScore: fatigueData.score
}) %>
</script>
<script>
  window.__chartData = JSON.parse(document.getElementById('chart-data-json').textContent);
</script>

<!-- Bottom Row: Today's Activity + Insights + Mood History -->
<div class="grid lg:grid-cols-3 gap-6 mb-6">

  <!-- Today's Activity -->
  <div class="glass-card p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-5" ><%= t('dashboard.todayActivity', 'Aktivitas Hari Ini') %></h3>
    <div class="space-y-4">
      <a href="/pomodoro" class="flex items-center justify-between p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700/50 transition-all group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-brand-500/15 flex items-center justify-center group-hover:scale-110 transition-transform">
            <i data-lucide="timer" class="w-4 h-4 text-brand-500"></i>
          </div>
          <span class="text-sm font-medium text-surface-200" ><%= t('dashboard.pomodoroSessions', 'Sesi Pomodoro') %></span>
        </div>
        <span class="text-lg font-bold font-display text-surface-50"><%= pomodoroToday.total_cycles %></span>
      </a>

      <a href="/quiz" class="flex items-center justify-between p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700/50 transition-all group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-accent-purple/15 flex items-center justify-center group-hover:scale-110 transition-transform">
            <i data-lucide="clipboard-check" class="w-4 h-4 text-accent-purple"></i>
          </div>
          <span class="text-sm font-medium text-surface-200" ><%= t('dashboard.quizzesTaken', 'Quiz Diambil') %></span>
        </div>
        <span class="text-lg font-bold font-display text-surface-50"><%= todayQuizCount %></span>
      </a>

      <a href="/analytics" class="flex items-center justify-between p-3 rounded-xl bg-surface-800/50 hover:bg-surface-700/50 transition-all group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-accent-teal/15 flex items-center justify-center group-hover:scale-110 transition-transform">
            <i data-lucide="bar-chart-3" class="w-4 h-4 text-accent-teal"></i>
          </div>
          <span class="text-sm font-medium text-surface-200" ><%= t('nav.analytics', 'Analitik') %></span>
        </div>
        <span class="text-lg font-bold font-display text-surface-50"><%= todayStats.session_count %></span>
      </a>
    </div>
  </div>

  <!-- Insights -->
  <div class="glass-card p-6">
    <div class="flex items-center gap-2 mb-5">
      <i data-lucide="lightbulb" class="w-5 h-5 text-warning-400"></i>
      <h3 class="text-lg font-bold font-display text-surface-50" ><%= t('dashboard.insights', 'Wawasan') %></h3>
    </div>
    <div class="space-y-4">
      <% recommendations.insights.forEach(function(ins, idx) { %>
      <div class="p-3 rounded-xl bg-surface-800/50 border-l-2 border-brand-500/50">
        <p class="text-sm text-surface-200 leading-relaxed mb-2 insight-desc" data-desc-id="<%= ins.description %>" data-desc-en="<%= ins.description_en || ins.description %>"><%= ins.description %></p>
      </div>
      <% }) %>
      <div class="p-3 rounded-xl bg-accent-teal/5 border border-accent-teal/20">
        <p class="text-sm text-surface-200 leading-relaxed mb-2 insight-desc" data-desc-id="<%= recommendations.moodTip %>" data-desc-en="<%= recommendations.moodTip_en || recommendations.moodTip %>"><%= recommendations.moodTip %></p>
        <button onclick="toggleChatbot()" class="text-xs font-semibold text-accent-teal hover:underline" ><%= t('dashboard.chatStart', 'Mulai Obrolan') %></button>
      </div>
    </div>
  </div>

  <!-- Mood History -->
  <div class="glass-card p-6">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold font-display text-surface-50" ><%= t('dashboard.moodHistory', 'Riwayat Mood') %></h3>
      <button onclick="openGlobalMood()" class="text-surface-400 hover:text-surface-200 transition-colors">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
      </button>
    </div>
    <% if (moodTrend && moodTrend.length > 0) { %>
    <div class="space-y-4">
      <% moodTrend.slice().reverse().slice(0, 7).forEach(function(entry) { %>
      <div class="border-b border-surface-700/30 pb-3 last:border-0 last:pb-0">
        <p class="text-[10px] text-surface-500 mb-1"><%= entry.log_date %>, <%= entry.log_time ? entry.log_time.substring(0,5) : '' %></p>
        <p class="text-sm text-surface-200 leading-relaxed">
          <span><%= t('mood.' + entry.mood_score, entry.mood_label) %></span> — <span ><%= t('dashboard.energy', 'Energi') %></span>: <%= entry.energy_level %>/5, <span ><%= t('dashboard.stress', 'Stres') %></span>: <%= entry.stress_level %>/5
        </p>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-8">
      <i data-lucide="smile" class="w-8 h-8 text-surface-500 mx-auto mb-2"></i>
      <p class="text-sm text-surface-400" ><%= t('dashboard.noMoodYet', 'Belum ada catatan mood.') %></p>
      <button onclick="openGlobalMood()" class="text-xs text-brand-500 hover:underline mt-1 inline-block" ><%= t('dashboard.startWriting', 'Mulai catat →') %></button>
    </div>
    <% } %>
  </div>
</div>

<!-- Fatigue Breakdown + Quick Actions Row -->
<div class="grid lg:grid-cols-3 gap-6 mb-6">
  <!-- Fatigue Breakdown -->
  <div class="lg:col-span-2 glass-card p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
      <i data-lucide="pie-chart" class="w-5 h-5 inline text-warning-400 mr-2"></i><%= t('dashboard.fatigueBreakdown', 'Rincian Kelelahan') %>
    </h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% const bl = { quiz:'Quiz', mood:'Mood', workload:'Beban Kerja', breaks:'Istirahat' }; %>
      <% for (const [k,l] of Object.entries(bl)) { %>
      <div class="text-center p-4 rounded-xl bg-surface-800/50">
        <div class="text-2xl font-bold font-display text-surface-50"><%= fatigueData.breakdown[k] %>%</div>
        <div class="text-xs text-surface-400 mt-1"><%= l %></div>
        <div class="mt-2 h-1.5 bg-surface-700 rounded-full overflow-hidden">
          <div class="h-full rounded-full gradient-brand" <%- `style="width:${fatigueData.breakdown[k]}%;"` %>></div>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Log Activity -->
  <div class="glass-card p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
      <i data-lucide="plus-circle" class="w-5 h-5 inline text-success-400 mr-1"></i><%= t('dashboard.logActivity', 'Catat Aktivitas') %>
    </h3>
    <form id="activity-form" class="space-y-3">
      <select name="activity_type" class="input-field text-sm">
        <option value="work" ><%= t('form.work', 'Kerja') %></option>
        <option value="study" ><%= t('form.study', 'Belajar') %></option>
        <option value="meeting" ><%= t('form.meeting', 'Rapat') %></option>
        <option value="other" ><%= t('form.other', 'Lainnya') %></option>
      </select>
      <input type="text" name="description" placeholder="Deskripsi kegiatan..." class="input-field text-sm">
      <div class="grid grid-cols-2 gap-3">
        <input type="number" name="duration_minutes" min="0" value="25" class="input-field text-sm" placeholder="Durasi (mnt)">
        <input type="number" name="break_minutes" min="0" value="5" class="input-field text-sm" placeholder="Istirahat (mnt)">
      </div>
      <button type="submit" class="btn-success w-full btn-sm"><i data-lucide="check" class="w-4 h-4"></i> <span ><%= t('form.save', 'Simpan') %></span></button>
    </form>
  </div>
</div>

<!-- Disclaimer -->
<div class="glass-card p-4 text-center">
  <p class="text-[10px] text-surface-500 leading-relaxed" ><%= t('dashboard.disclaimer', 'HAPI dirancang untuk memberikan wawasan seputar kelelahan. Ini bukan pengganti saran medis profesional. Selalu konsultasikan dengan dokter atau tenaga kesehatan profesional untuk pertanyaan medis.') %></p>
</div>

<!-- Mood Modal -->
<div id="mood-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="glass-card p-8 w-full max-w-md mx-4 animate-scale-in">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold font-display text-surface-50" ><%= t('mood.title', 'Bagaimana Perasaanmu?') %></h3>
      <button onclick="closeMoodModal()" class="text-surface-400 hover:text-surface-200"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <form id="mood-form" class="space-y-6">
      <div class="flex justify-between gap-2" id="mood-selector">
        <% [{s:1,e:'😞',l:'Sangat Buruk'},{s:2,e:'😕',l:'Buruk'},{s:3,e:'😐',l:'Biasa'},{s:4,e:'😊',l:'Baik'},{s:5,e:'😄',l:'Sangat Baik'}].forEach(function(m){ %>
        <button type="button" class="flex-1 py-3 rounded-xl text-center hover:bg-surface-700/50 border border-transparent mood-btn" data-score="<%= m.s %>" data-label="<%= m.l %>">
          <div class="text-2xl"><%= m.e %></div><div class="text-[10px] text-surface-400 mt-1"><%= m.l %></div>
        </button>
        <% }) %>
      </div>
      <div><label class="input-label" ><%= t('mood.energy', 'Tingkat Energi') %></label><input type="range" min="1" max="5" value="3" class="w-full accent-brand-500" name="energy_level" id="energy-slider"></div>
      <div><label class="input-label" ><%= t('mood.stress', 'Tingkat Stres') %></label><input type="range" min="1" max="5" value="3" class="w-full accent-danger-500" name="stress_level" id="stress-slider"></div>
      <textarea name="notes" rows="2" placeholder="Ada yang ingin diceritakan? (opsional)" class="input-field resize-none" id="mood-notes"></textarea>
      <button type="submit" class="btn-primary w-full"><i data-lucide="save" class="w-4 h-4"></i> <span ><%= t('mood.saveMood', 'Simpan Mood') %></span></button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const isDarkMode = document.documentElement.getAttribute('data-theme') !== 'light';
    const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
    const todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: userTz }).format(new Date());
    
    const showMoodReminderFlag = <%= showMoodReminder %> && (localStorage.getItem('moodReminderSeenDate') !== todayStr);
    const showQuizReminderFlag = <%= typeof showQuizReminder !== 'undefined' ? showQuizReminder : false %> && (localStorage.getItem('quizReminderSeenDate') !== todayStr);

    const checkQuizReminder = () => {
      const banner = document.getElementById('quiz-warning-banner');
      if (showQuizReminderFlag) {
        localStorage.setItem('quizReminderSeenDate', todayStr);
        Swal.fire({
          title: window.t ? window.t('dashboard.swal.quizTitle') : 'Jangan lupa isi Quiz hari ini!',
          text: window.t ? window.t('dashboard.swal.quizText') : 'Isi quiz sekarang untuk melihat tingkat kelelahanmu dan menjaga streak tetap menyala!',
          icon: 'info',
          showCancelButton: true,
          confirmButtonText: window.t ? window.t('dashboard.swal.quizConfirm') : 'Mulai Quiz',
          cancelButtonText: window.t ? window.t('dashboard.swal.later') : 'Nanti Saja',
          confirmButtonColor: '#A86240',
          cancelButtonColor: '#489A98',
          background: isDarkMode ? '#1e1611' : '#ffffff',
          color: isDarkMode ? '#f8f4f0' : '#3a1e13',
          backdrop: 'rgba(0,0,0,0.75)',
          position: 'center',
          customClass: {
            container: 'z-[99999]'
          }
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = '/quiz';
          } else {
            if (banner) banner.style.display = 'flex';
          }
        });
      } else if (<%= typeof showQuizReminder !== 'undefined' ? showQuizReminder : false %>) {
        if (banner) banner.style.display = 'flex';
      }
    };

    if (showMoodReminderFlag) {
      localStorage.setItem('moodReminderSeenDate', todayStr);
      Swal.fire({
        title: window.t ? window.t('dashboard.swal.moodTitle') : 'Bagaimana perasaanmu hari ini?',
        text: window.t ? window.t('dashboard.swal.moodText') : 'Kamu belum mencatat mood hari ini. Catat sekarang untuk menjaga streakmu!',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: window.t ? window.t('dashboard.swal.moodConfirm') : 'Catat Mood Sekarang',
        cancelButtonText: window.t ? window.t('dashboard.swal.later') : 'Nanti Saja',
        confirmButtonColor: '#A86240',
        cancelButtonColor: '#489A98',
        background: isDarkMode ? '#1e1611' : '#ffffff',
        color: isDarkMode ? '#f8f4f0' : '#3a1e13',
        backdrop: 'rgba(0,0,0,0.75)',
        position: 'center',
        customClass: {
          container: 'z-[99999]'
        }
      }).then((result) => {
        if (result.isConfirmed) {
          openGlobalMood();
        } else {
          checkQuizReminder();
        }
      });
    } else {
      checkQuizReminder();
    }
  });
</script>
