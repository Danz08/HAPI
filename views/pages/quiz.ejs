<!-- Quiz Page - Akinator Style -->
<div class="max-w-2xl mx-auto">
  <!-- Progress -->
  <div class="glass-card p-4 mb-6">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm text-surface-400"><span data-i18n="quiz.question">Pertanyaan</span> <span id="q-current">1</span> <span data-i18n="quiz.of">dari</span> <span id="q-total"><%= questions.length %></span></span>
      <span class="text-sm text-brand-400 font-semibold" id="q-dimension"></span>
    </div>
    <div class="h-2 bg-surface-700 rounded-full overflow-hidden">
      <div id="q-progress" class="h-full gradient-brand rounded-full transition-all duration-500" style="width: 10%"></div>
    </div>
  </div>

  <!-- Question Card -->
  <div id="quiz-container" class="glass-card p-8">
    <div id="quiz-question" class="animate-fade-in">
      <h3 id="q-text" class="text-xl font-bold font-display text-surface-50 mb-8 leading-relaxed"></h3>
      <div id="q-options" class="space-y-3"></div>
    </div>

    <!-- Result (hidden initially) -->
    <div id="quiz-result" class="hidden text-center">
      <div id="result-icon" class="text-6xl mb-4"></div>
      <h3 id="result-title" class="text-2xl font-bold font-display text-surface-50 mb-2"></h3>
      <p id="result-score" class="text-4xl font-bold font-mono mb-2"></p>
      <span id="result-badge" class="badge mb-6 inline-flex"></span>
      <div id="result-recommendations" class="text-left mt-6 space-y-3"></div>
      <div class="mt-8 flex gap-3 justify-center">
        <a href="/dashboard" class="btn-secondary"><i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard</a>
        <button onclick="restartQuiz()" class="btn-primary"><i data-lucide="refresh-cw" class="w-4 h-4"></i> <span data-i18n="quiz.restart">Ulangi Quiz</span></button>
      </div>
    </div>
  </div>

  <div class="mt-4 text-center">
    <p class="text-xs text-surface-500" data-i18n="quiz.disclaimer">⚠️ Hasil quiz ini bukan diagnosis medis. Konsultasikan dengan profesional jika diperlukan.</p>
  </div>
</div>

<script>
const questions = <%- JSON.stringify(questions) %>;
let currentQ = 0;
let answers = [];
const dimLabels = { emotional_exhaustion:'Kelelahan Emosional', depersonalization:'Depersonalisasi', personal_accomplishment:'Pencapaian Personal', work_pattern:'Pola Kerja' };

function showQuestion(idx) {
  if (idx >= questions.length) { submitQuiz(); return; }
  const q = questions[idx];
  document.getElementById('q-current').textContent = idx + 1;
  document.getElementById('q-progress').style.width = ((idx + 1) / questions.length * 100) + '%';
  document.getElementById('q-dimension').textContent = dimLabels[q.dimension] || '';
  document.getElementById('q-text').textContent = q.text;

  const optContainer = document.getElementById('q-options');
  optContainer.innerHTML = '';
  q.options.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'quiz-option w-full text-left px-5 py-4 flex items-center gap-4';
    btn.innerHTML = `<span class="w-8 h-8 rounded-lg bg-surface-700 flex items-center justify-center text-sm font-bold text-surface-300">${opt.value}</span><span class="text-surface-200 font-medium">${opt.label}</span>`;
    btn.onclick = () => selectAnswer(opt.value);
    optContainer.appendChild(btn);
  });

  document.getElementById('quiz-question').classList.remove('animate-fade-in');
  void document.getElementById('quiz-question').offsetWidth;
  document.getElementById('quiz-question').classList.add('animate-fade-in');
}

function selectAnswer(val) {
  answers[currentQ] = val;
  currentQ++;
  showQuestion(currentQ);
}

async function submitQuiz() {
  document.getElementById('quiz-question').classList.add('hidden');
  document.getElementById('quiz-result').classList.remove('hidden');

  try {
    const res = await axios.post('/api/quiz', { answers });
    const data = res.data;

    const icons = { Low:'🟢', Medium:'⚠️', High:'🔴' };
    const titles = { Low:'Risiko Rendah', Medium:'Risiko Sedang', High:'Risiko Tinggi' };

    document.getElementById('result-icon').textContent = icons[data.riskLevel] || '❓';
    document.getElementById('result-title').textContent = titles[data.riskLevel];
    document.getElementById('result-score').textContent = data.score;
    document.getElementById('result-score').style.color = data.riskColor.text;

    const badge = document.getElementById('result-badge');
    badge.textContent = data.riskLevel + ' Risk';
    badge.className = `badge badge-${data.riskLevel.toLowerCase()} inline-flex`;

    const recContainer = document.getElementById('result-recommendations');
    recContainer.innerHTML = '<h4 class="text-lg font-bold text-surface-50 mb-2" data-i18n="quiz.result">Rekomendasi:</h4>';
    data.recommendations.activities.forEach(a => {
      recContainer.innerHTML += `<div class="p-3 rounded-xl bg-surface-800/50 text-sm text-surface-300 flex gap-2"><span>•</span><span>${a}</span></div>`;
    });
  } catch(e) {
    document.getElementById('result-title').textContent = 'Terjadi Kesalahan';
  }
}

function restartQuiz() {
  currentQ = 0; answers = [];
  document.getElementById('quiz-question').classList.remove('hidden');
  document.getElementById('quiz-result').classList.add('hidden');
  showQuestion(0);
}

showQuestion(0);
</script>
