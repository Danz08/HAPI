<!-- Activity Analytics Page -->
<div class="space-y-6">

  <!-- Month Navigation -->
  <div class="flex items-center justify-between">
    <div></div>
    <div class="flex items-center gap-2">
      <a href="/analytics?month=<%= prevMonth %>&year=<%= prevYear %>" class="btn-ghost btn-sm" id="btn-prev-month">
        <i data-lucide="chevron-left" class="w-4 h-4"></i>
      </a>
      <span class="text-surface-100 font-bold font-display text-lg min-w-[160px] text-center"><%= monthName %> <%= year %></span>
      <a href="/analytics?month=<%= nextMonth %>&year=<%= nextYear %>" class="btn-ghost btn-sm" id="btn-next-month">
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
      </a>
    </div>
  </div>

  <!-- Monthly Summary Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
    <div class="stat-card">
      <div class="w-9 h-9 rounded-xl bg-brand-500/15 flex items-center justify-center mb-2">
        <i data-lucide="calendar-check" class="w-5 h-5 text-brand-400"></i>
      </div>
      <div class="stat-value text-xl"><%= activeDays %>/<%= daysInMonth %></div>
      <div class="stat-label" data-i18n="analytics.activeDays">Hari Aktif</div>
    </div>
    <div class="stat-card">
      <div class="w-9 h-9 rounded-xl bg-accent-purple/15 flex items-center justify-center mb-2">
        <i data-lucide="clock" class="w-5 h-5 text-accent-purple"></i>
      </div>
      <div class="stat-value text-xl"><%= Math.floor(monthlyWork.total / 60) %>h <%= monthlyWork.total % 60 %>m</div>
      <div class="stat-label" data-i18n="analytics.totalWork">Total Kerja</div>
    </div>
    <div class="stat-card">
      <div class="w-9 h-9 rounded-xl bg-success-500/15 flex items-center justify-center mb-2">
        <i data-lucide="timer" class="w-5 h-5 text-success-400"></i>
      </div>
      <div class="stat-value text-xl"><%= monthlyPomodoro.cycles %></div>
      <div class="stat-label" data-i18n="analytics.pomodoroCycles">Siklus Pomodoro</div>
    </div>
    <div class="stat-card">
      <div class="w-9 h-9 rounded-xl bg-accent-pink/15 flex items-center justify-center mb-2">
        <i data-lucide="heart" class="w-5 h-5 text-accent-pink"></i>
      </div>
      <% const avgM = monthlyMood.avg ? (Math.round(monthlyMood.avg * 10) / 10) : 0; %>
      <div class="stat-value text-xl"><%= avgM > 0 ? avgM + '/5' : '—' %></div>
      <div class="stat-label" data-i18n="analytics.avgMood">Avg Mood</div>
    </div>
    <div class="stat-card">
      <div class="w-9 h-9 rounded-xl bg-warning-500/15 flex items-center justify-center mb-2">
        <i data-lucide="flame" class="w-5 h-5 text-warning-400"></i>
      </div>
      <div class="stat-value text-xl"><%= streak %></div>
      <div class="stat-label" data-i18n="analytics.streak">Streak Hari</div>
    </div>
  </div>

  <!-- Calendar + Detail Panel -->
  <div class="grid lg:grid-cols-3 gap-6">
    <!-- Calendar -->
    <div class="lg:col-span-2 glass-card p-6">
      <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
        <i data-lucide="calendar" class="w-5 h-5 inline text-brand-400 mr-2"></i><span data-i18n="analytics.calendar">Kalender Aktivitas</span>
      </h3>
      <!-- Legend -->
      <div class="flex flex-wrap items-center gap-2 md:gap-4 mb-4 text-[10px] md:text-xs text-surface-400">
        <span data-i18n="analytics.legend.intensity">Intensitas:</span>
        <div class="flex items-center gap-1">
          <div class="w-4 h-4 rounded bg-surface-800 border border-surface-700"></div>
          <span data-i18n="analytics.legend.none">Tidak ada</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="w-4 h-4 rounded bg-brand-900/60"></div>
          <span data-i18n="analytics.legend.low">Rendah</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="w-4 h-4 rounded bg-brand-700/70"></div>
          <span data-i18n="analytics.legend.med">Sedang</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="w-4 h-4 rounded bg-brand-500"></div>
          <span data-i18n="analytics.legend.high">Tinggi</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="w-4 h-4 rounded bg-brand-400 shadow-lg shadow-brand-400/30"></div>
          <span data-i18n="analytics.legend.max">Maksimal</span>
        </div>
      </div>

      <!-- Calendar Grid -->
      <div class="grid grid-cols-7 gap-1.5">
        <!-- Day headers -->
        <% ['Min','Sen','Sel','Rab','Kam','Jum','Sab'].forEach(d => { %>
          <div class="text-center text-xs font-semibold text-surface-500 py-1.5" data-i18n="analytics.day.<%= d %>"><%= d %></div>
        <% }) %>

        <!-- Empty cells for first week offset -->
        <% for (let i = 0; i < firstDayOfWeek; i++) { %>
          <div></div>
        <% } %>

        <!-- Calendar days -->
        <% calendarData.forEach(function(cd) { %>
          <% 
            const intensityClasses = [
              'bg-surface-800/60 border-surface-700/50',
              'bg-brand-900/50 border-brand-800/50',
              'bg-brand-700/60 border-brand-600/50',
              'bg-brand-500/70 border-brand-400/50',
              'bg-brand-400 border-brand-300/50 shadow-md shadow-brand-400/20'
            ];
            const cls = intensityClasses[cd.intensity];
            const pad = (n) => String(n).padStart(2, '0');
            const _d = new Date();
            const localToday = `${_d.getFullYear()}-${pad(_d.getMonth() + 1)}-${pad(_d.getDate())}`;
            const isToday = cd.date === localToday;
            const moodEmojis = { 1:'😞', 2:'😕', 3:'😐', 4:'😊', 5:'😄' };
            const moodEmoji = cd.avg_mood ? moodEmojis[Math.round(cd.avg_mood)] || '' : '';
          %>
          <button 
            class="calendar-cell aspect-square rounded-lg border p-1 flex flex-col items-center justify-center text-xs transition-all hover:scale-105 hover:ring-2 hover:ring-brand-400/40 cursor-pointer relative group <%= cls %> <%= isToday ? 'ring-2 ring-brand-400' : '' %>"
            onclick="showDayDetail('<%= cd.date %>')"
            data-date="<%= cd.date %>"
            title="<%= cd.date %>: <%= cd.work_minutes %>min kerja, <%= cd.pomodoro_cycles %> pomodoro<%= cd.avg_mood ? ', mood ' + cd.avg_mood : '' %>"
          >
            <span class="font-bold <%= isToday ? 'text-brand-300' : cd.hasData ? 'text-surface-200' : 'text-surface-500' %>"><%= cd.day %></span>
            <% if (cd.hasData) { %>
              <div class="flex items-center gap-0.5 mt-0.5">
                <% if (moodEmoji) { %><span class="text-[9px]"><%= moodEmoji %></span><% } %>
                <% if (cd.pomodoro_cycles > 0) { %><span class="text-[9px]">🍅</span><% } %>
                <% if (cd.quiz_score !== null) { %><span class="text-[9px]">📋</span><% } %>
              </div>
            <% } %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Day Detail Panel -->
    <div class="space-y-4">
      <div class="glass-card p-6" id="day-detail-panel">
        <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
          <i data-lucide="info" class="w-5 h-5 inline text-brand-400 mr-2"></i>
          <span id="detail-title" data-i18n="analytics.detailTitle">Detail Hari</span>
        </h3>
        <div id="day-detail-content">
          <p class="text-sm text-surface-400 text-center py-8" data-i18n="analytics.detailEmpty">Klik tanggal di kalender untuk melihat detail aktivitas</p>
        </div>
      </div>

      <!-- Monthly Insights -->
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
          <i data-lucide="lightbulb" class="w-5 h-5 inline text-warning-400 mr-1"></i><span data-i18n="analytics.insights">Insights</span>
        </h3>
        <div class="space-y-3">
          <% insights.forEach(function(ins) { %>
          <% const borderColorClass = ins.color === 'brand' ? 'border-brand-500/50' : ins.color === 'success' ? 'border-success-500/50' : ins.color === 'warning' ? 'border-warning-500/50' : 'border-danger-500/50'; %>
          <div class="p-3 rounded-xl bg-surface-800/50 border-l-2 <%= borderColorClass %>">
            <p class="text-sm font-semibold text-surface-200 mb-1 insight-title" data-title-id="<%= ins.title %>" data-title-en="<%= ins.title_en || ins.title %>"><%= ins.icon %> <span><%= ins.title %></span></p>
            <p class="text-xs text-surface-400 insight-desc" data-desc-id="<%= ins.description %>" data-desc-en="<%= ins.desc_en || ins.description %>"><%= ins.description %></p>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Work Trend Chart -->
    <div class="glass-card p-6">
      <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
        <i data-lucide="bar-chart-3" class="w-5 h-5 inline text-brand-400 mr-2"></i><span data-i18n="analytics.workActivity">Aktivitas Kerja</span>
      </h3>
      <div class="h-56"><canvas id="workTrendChart"></canvas></div>
    </div>

    <!-- Mood Trend Chart -->
    <div class="glass-card p-6">
      <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
        <i data-lucide="trending-up" class="w-5 h-5 inline text-accent-pink mr-2"></i><span data-i18n="analytics.moodTrend">Tren Mood</span>
      </h3>
      <div class="h-56"><canvas id="moodTrendChart"></canvas></div>
    </div>
  </div>

  <!-- Activity Type Breakdown -->
   <% if (activityTypes.length > 0) { %>
  <div class="glass-card p-6">
    <h3 class="text-lg font-bold font-display text-surface-50 mb-4">
      <i data-lucide="pie-chart" class="w-5 h-5 inline text-accent-purple mr-2"></i><span data-i18n="analytics.activityBreakdown">Breakdown Aktivitas</span>
    </h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% 
        const typeLabels = { work: 'Kerja', study: 'Belajar', meeting: 'Meeting', other: 'Lainnya', pomodoro: 'Pomodoro' };
        const typeColors = { work: 'brand', study: 'accent-purple', meeting: 'warning', other: 'surface', pomodoro: 'success' };
        const totalMins = activityTypes.reduce((s, t) => s + t.total_minutes, 0);
        activityTypes.forEach(function(at) {
          const pct = totalMins > 0 ? Math.round((at.total_minutes / totalMins) * 100) : 0;
          const color = typeColors[at.activity_type] || 'surface';
      %>
      <div class="text-center p-4 rounded-xl bg-surface-800/50">
        <div class="text-2xl font-bold font-display text-surface-50"><%= pct %>%</div>
        <div class="text-xs text-surface-400 mt-1"><%= typeLabels[at.activity_type] || at.activity_type %></div>
        <div class="text-[10px] text-surface-500"><%= at.count %> sesi · <%= Math.floor(at.total_minutes / 60) %>h <%= at.total_minutes % 60 %>m</div>
        <div class="mt-2 h-1.5 bg-surface-700 rounded-full overflow-hidden">
          <div class="h-full rounded-full gradient-brand" style="width:<%= pct %>%"></div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Google Calendar Integration Section -->
  <div class="glass-card p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold font-display text-surface-50">
        <i data-lucide="calendar-sync" class="w-5 h-5 inline text-brand-400 mr-2"></i>Google Calendar & Burnout Analysis
      </h3>
      <% if (isGoogleConnected) { %>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-success-500/10 text-success-400 text-xs font-semibold border border-success-500/20">
            <span class="w-1.5 h-1.5 bg-success-400 rounded-full animate-pulse-soft"></span>
            <span data-i18n="analytics.googleConnected">Terhubung</span>
          </span>
          <button onclick="syncCalendar()" class="btn-ghost btn-sm" id="btn-sync-cal" title="Sinkronisasi ulang">
            <i data-lucide="refresh-cw" class="w-4 h-4"></i>
          </button>
          <a href="/auth/google/disconnect" class="btn-ghost btn-sm text-danger-400 hover:text-danger-300" title="Putuskan" onclick="return confirm('Putuskan Google Calendar?')">
            <i data-lucide="unlink" class="w-4 h-4"></i>
          </a>
        </div>
      <% } else { %>
        <a href="/auth/google" class="btn-primary btn-sm group" id="btn-connect-google">
          <i data-lucide="link" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
          <span data-i18n="analytics.googleConnect">Hubungkan Google Calendar</span>
        </a>
      <% } %>
    </div>

    <% if (!isGoogleConnected) { %>
      <!-- Not Connected State -->
      <div class="text-center py-8">
        <div class="w-16 h-16 rounded-2xl bg-brand-500/10 flex items-center justify-center mx-auto mb-4">
          <i data-lucide="calendar-plus" class="w-8 h-8 text-brand-400"></i>
        </div>
        <h4 class="text-surface-200 font-semibold mb-2" data-i18n="analytics.googleConnect">Hubungkan Google Calendar</h4>
        <p class="text-sm text-surface-400 max-w-md mx-auto mb-4" data-i18n="analytics.googleDesc">
          Analisis jadwalmu secara otomatis untuk mendeteksi risiko burnout berdasarkan jumlah meeting, 
          durasi kerja, dan meeting back-to-back.
        </p>
        <div class="flex flex-wrap justify-center gap-3 text-xs text-surface-500">
          <span class="flex items-center gap-1"><i data-lucide="shield-check" class="w-3.5 h-3.5 text-success-400"></i> <span data-i18n="analytics.googleFeature1">Read-only access</span></span>
          <span class="flex items-center gap-1"><i data-lucide="lock" class="w-3.5 h-3.5 text-brand-400"></i> <span data-i18n="analytics.googleFeature2">Data tetap privat</span></span>
          <span class="flex items-center gap-1"><i data-lucide="unlink" class="w-3.5 h-3.5 text-surface-400"></i> <span data-i18n="analytics.googleFeature3">Bisa diputuskan kapan saja</span></span>
        </div>
      </div>
    <% } else { %>
      <!-- Connected State: Calendar Burnout Dashboard -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="text-center p-4 rounded-xl bg-surface-800/50">
          <div class="text-2xl font-bold font-display text-surface-50"><%= monthlyCalendar.total_meetings %></div>
          <div class="text-xs text-surface-400" data-i18n="analytics.totalMeeting">Total Meeting</div>
        </div>
        <div class="text-center p-4 rounded-xl bg-surface-800/50">
          <div class="text-2xl font-bold font-display text-surface-50"><%= Math.round(monthlyCalendar.avg_work_hours * 10) / 10 %>h</div>
          <div class="text-xs text-surface-400" data-i18n="analytics.avgDuration">Avg Durasi/Hari</div>
        </div>
        <div class="text-center p-4 rounded-xl bg-surface-800/50">
          <div class="text-2xl font-bold font-display text-surface-50"><%= monthlyCalendar.total_b2b %></div>
          <div class="text-xs text-surface-400" data-i18n="analytics.b2b">Back-to-Back</div>
        </div>
        <% 
          const calBurnout = Math.round(monthlyCalendar.avg_burnout_score);
          const burnoutClass = calBurnout > 65 ? 'bg-danger-500/10 border border-danger-500/20' : calBurnout > 35 ? 'bg-warning-500/10 border border-warning-500/20' : 'bg-success-500/10 border border-success-500/20';
        %>
        <div class="text-center p-4 rounded-xl <%= burnoutClass %>">
          <div class="text-2xl font-bold font-display <%= calBurnout > 65 ? 'text-danger-400' : calBurnout > 35 ? 'text-warning-400' : 'text-success-400' %>"><%= calBurnout %>%</div>
          <div class="text-xs text-surface-400" data-i18n="analytics.calBurnout">Calendar Burnout Score</div>
          <div class="text-[10px] mt-1 <%= calBurnout > 65 ? 'text-danger-400' : calBurnout > 35 ? 'text-warning-400' : 'text-success-400' %>">
            <%= calBurnout > 65 ? '⚠️ Tinggi' : calBurnout > 35 ? '⚡ Sedang' : '✅ Rendah' %>
          </div>
        </div>
      </div>

      <!-- Calendar Burnout Trend Chart -->
      <% if (calendarFeatures.length > 0) { %>
      <div class="h-48">
        <canvas id="calBurnoutChart"></canvas>
      </div>
      <% } else { %>
      <p class="text-sm text-surface-400 text-center py-4" data-i18n="analytics.noCalData">Belum ada data kalender untuk bulan ini. Klik sync untuk memperbarui.</p>
      <% } %>
    <% } %>
  </div>
</div>

<script>
// === Calendar Sync ===
async function syncCalendar() {
  const btn = document.getElementById('btn-sync-cal');
  if (btn) btn.disabled = true;
  try {
    const res = await axios.post('/auth/google/sync', { days: 30 });
    if (res.data.success) {
      window.showToast?.('Kalender berhasil disinkronisasi! 📅', 'success');
      setTimeout(() => location.reload(), 1000);
    } else {
      window.showToast?.(res.data.error || 'Gagal sync.', 'error');
    }
  } catch(e) {
    window.showToast?.('Gagal menyinkronisasi kalender.', 'error');
  } finally {
    if (btn) btn.disabled = false;
  }
}

// === Day Detail AJAX ===
async function showDayDetail(dateStr) {
  const panel = document.getElementById('day-detail-content');
  const title = document.getElementById('detail-title');
  
  // Highlight selected
  document.querySelectorAll('.calendar-cell').forEach(c => c.classList.remove('ring-2', 'ring-accent-pink'));
  const selected = document.querySelector(`[data-date="${dateStr}"]`);
  if (selected) selected.classList.add('ring-2', 'ring-accent-pink');

  const d = new Date(dateStr);
  const dayNames = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
  title.textContent = `${dayNames[d.getDay()]}, ${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;

  const t = window.t || (k => k.split('.').pop());
  panel.innerHTML = `<p class="text-sm text-surface-400 text-center py-4">${t('analytics.detail.loading')}</p>`;

  try {
    const res = await axios.get(`/api/analytics/day/${dateStr}`);
    const data = res.data;
    let html = '';

    // Activities summary
    if (data.activities.length > 0) {
      const totalWork = data.activities.reduce((s, a) => s + a.duration_minutes, 0);
      const totalBreak = data.activities.reduce((s, a) => s + a.break_minutes, 0);
      html += `<div class="mb-3"><p class="text-xs font-semibold text-brand-400 mb-1">💼 ${t('analytics.detail.activities')} (${data.activities.length})</p>`;
      html += `<p class="text-sm text-surface-200">${Math.floor(totalWork/60)}h ${totalWork%60}m ${t('analytics.detail.work')} · ${totalBreak}m ${t('analytics.detail.break')}</p>`;
      data.activities.forEach(a => {
        const typeMap = {work:t('analytics.detail.workType'),study:t('analytics.detail.studyType'),meeting:'Meeting',other:t('analytics.detail.otherType'),pomodoro:'Pomodoro'};
        html += `<div class="text-xs text-surface-400 mt-1">• ${typeMap[a.activity_type]||a.activity_type}: ${a.duration_minutes}m${a.description ? ' — '+a.description : ''}</div>`;
      });
      html += '</div>';
    }

    // Mood summary
    if (data.moods.length > 0) {
      const moodEmojis = {1:'😞',2:'😕',3:'😐',4:'😊',5:'😄'};
      html += `<div class="mb-3"><p class="text-xs font-semibold text-accent-pink mb-1">💗 ${t('analytics.detail.mood')}</p>`;
      data.moods.forEach(m => {
        const moodName = t(`mood.${m.mood_score}`) || m.mood_label;
        html += `<div class="flex items-center gap-2 text-sm text-surface-200 mt-1">${moodEmojis[m.mood_score]||'😐'} ${moodName}`;
        if (m.energy_level) html += ` <span class="text-xs text-surface-400">⚡${m.energy_level}</span>`;
        if (m.stress_level) html += ` <span class="text-xs text-surface-400">😰${m.stress_level}</span>`;
        html += '</div>';
        if (m.notes) html += `<p class="text-xs text-surface-500 ml-6 italic">"${m.notes}"</p>`;
      });
      html += '</div>';
    }

    // Pomodoro summary
    if (data.pomodoros.length > 0) {
      const totalCycles = data.pomodoros.reduce((s, p) => s + p.cycles_completed, 0);
      const totalFocus = data.pomodoros.reduce((s, p) => s + p.total_focus_minutes, 0);
      html += `<div class="mb-3"><p class="text-xs font-semibold text-success-400 mb-1">🍅 Pomodoro</p>`;
      html += `<p class="text-sm text-surface-200">${totalCycles} ${t('analytics.detail.cycles')} · ${totalFocus}m ${t('analytics.detail.focus')}</p></div>`;
    }

    // Quiz summary
    if (data.quiz) {
      const riskLabels = {Low:t('analytics.detail.riskLow'),Medium:t('analytics.detail.riskMed'),High:t('analytics.detail.riskHigh')};
      html += `<div class="mb-3"><p class="text-xs font-semibold text-warning-400 mb-1">📋 ${t('analytics.detail.quiz')}</p>`;
      html += `<p class="text-sm text-surface-200">${t('analytics.detail.score')}: ${Math.round(data.quiz.fatigue_score)}% <span class="badge-${data.quiz.risk_level.toLowerCase()}">${riskLabels[data.quiz.risk_level] || data.quiz.risk_level}</span></p></div>`;
    }

    // Calendar events summary
    if (data.calEvents && data.calEvents.length > 0) {
      html += `<div class="mb-3"><p class="text-xs font-semibold text-brand-400 mb-1">📅 ${t('analytics.detail.cal')}</p>`;
      data.calEvents.forEach(ev => {
        const start = ev.start_time.includes('T') ? ev.start_time.substring(11, 16) : t('analytics.detail.allDay');
        const end = ev.end_time.includes('T') ? ev.end_time.substring(11, 16) : '';
        const typeIcons = { meeting: '🤝', break: '☕', deadline: '⏰', event: '📌' };
        html += `<div class="text-xs text-surface-400 mt-1">${typeIcons[ev.event_type] || '📌'} ${start}${end ? '–'+end : ''} ${ev.title}</div>`;
      });
      if (data.calFeature) {
        const bs = Math.round(data.calFeature.calendar_burnout_score);
        const bsColor = bs > 65 ? 'danger' : bs > 35 ? 'warning' : 'success';
        html += `<div class="mt-2 p-2 rounded-lg bg-${bsColor}-500/10 border border-${bsColor}-500/20">`;
        html += `<p class="text-xs text-${bsColor}-400">🔥 Burnout Score: ${bs}% · ${data.calFeature.meetings_count} ${t('analytics.detail.meeting')} · ${data.calFeature.back_to_back_count} ${t('analytics.detail.b2b')}</p>`;
        html += '</div>';
      }
      html += '</div>';
    }

    if (!html) {
      html = `<p class="text-sm text-surface-500 text-center py-4">${t('analytics.detail.empty')}</p>`;
    }

    panel.innerHTML = html;
  } catch(e) {
    const t = window.t || (k => k);
    panel.innerHTML = `<p class="text-sm text-danger-400 text-center py-4">${t('analytics.detail.error')}</p>`;
  }
}

// === Charts ===
document.addEventListener('DOMContentLoaded', () => {
  if (typeof Chart === 'undefined') return;
  Chart.defaults.color = '#94a3b8';
  Chart.defaults.font.family = 'Inter';

  // Work trend chart
  const workCtx = document.getElementById('workTrendChart');
  if (workCtx) {
    const workData = <%- JSON.stringify(workTrend) %>;
    new Chart(workCtx, {
      type: 'bar',
      data: {
        labels: workData.map(d => d.label),
        datasets: [
          { label: 'Kerja (mnt)', data: workData.map(d => d.work), backgroundColor: 'rgba(59,142,255,0.6)', borderRadius: 4 },
          { label: 'Istirahat (mnt)', data: workData.map(d => d.breakMin), backgroundColor: 'rgba(167,139,250,0.4)', borderRadius: 4 },
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { usePointStyle: true, pointStyle: 'circle' } } },
        scales: {
          x: { grid: { display: false }, ticks: { maxTicksLimit: 10 } },
          y: { grid: { color: 'rgba(100,116,139,0.1)' }, beginAtZero: true }
        }
      }
    });
  }

  // Mood trend chart
  const moodCtx = document.getElementById('moodTrendChart');
  if (moodCtx) {
    const moodData = <%- JSON.stringify(moodTrend) %>;
    new Chart(moodCtx, {
      type: 'line',
      data: {
        labels: moodData.map(d => d.label),
        datasets: [{
          label: 'Mood',
          data: moodData.map(d => d.score),
          borderColor: '#f472b6',
          backgroundColor: 'rgba(244,114,182,0.1)',
          fill: true,
          tension: 0.4,
          pointRadius: 4,
          pointBackgroundColor: '#f472b6',
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { maxTicksLimit: 10 } },
          y: { min: 1, max: 5, grid: { color: 'rgba(100,116,139,0.1)' },
            ticks: { stepSize: 1, callback: v => ['','😞','😕','😐','😊','😄'][v] || v }
          }
        }
      }
    });
  }

  // Calendar Burnout trend chart
  const calCtx = document.getElementById('calBurnoutChart');
  if (calCtx) {
    const calData = <%- JSON.stringify(calendarFeatures) %>;
    new Chart(calCtx, {
      type: 'line',
      data: {
        labels: calData.map(d => d.date.substring(8, 10)),
        datasets: [
          {
            label: 'Burnout Score',
            data: calData.map(d => Math.round(d.calendar_burnout_score)),
            borderColor: '#ef4444',
            backgroundColor: 'rgba(239,68,68,0.1)',
            fill: true,
            tension: 0.4,
            pointRadius: 3,
            pointBackgroundColor: '#ef4444',
            yAxisID: 'y',
          },
          {
            label: 'Meetings',
            data: calData.map(d => d.meetings_count),
            borderColor: '#3b8eff',
            backgroundColor: 'rgba(59,142,255,0.1)',
            fill: false,
            tension: 0.4,
            pointRadius: 3,
            pointBackgroundColor: '#3b8eff',
            yAxisID: 'y1',
          }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 8 } } },
        scales: {
          x: { grid: { display: false } },
          y: { position: 'left', min: 0, max: 100, grid: { color: 'rgba(100,116,139,0.1)' },
            title: { display: true, text: 'Burnout %', color: '#ef4444' }
          },
          y1: { position: 'right', min: 0, grid: { display: false },
            title: { display: true, text: 'Meetings', color: '#3b8eff' }
          }
        }
      }
    });
  }

  // Auto-load today's detail if available
  setTimeout(() => {
    const todayCell = document.querySelector('.calendar-cell.ring-brand-400');
    if (todayCell) {
      const todayDate = todayCell.getAttribute('data-date');
      if (todayDate) {
        showDayDetail(todayDate);
      }
    }
  }, 100);
});
</script>

