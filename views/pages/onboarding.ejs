<!-- Onboarding Page (Carousel) -->
<div class="h-[calc(100vh-8rem)] flex items-center justify-center p-4">
  
  <div class="glass-card w-full max-w-4xl h-full max-h-[600px] flex flex-col relative overflow-hidden shadow-2xl shadow-brand-500/5">
    
    <!-- Slides Container -->
    <div id="onboarding-slides" class="flex-1 flex transition-transform duration-500 ease-in-out w-full">
      
      <!-- Slide 1: Welcome -->
      <div class="w-full shrink-0 h-full flex flex-col items-center justify-center p-6 md:p-16 text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl gradient-brand flex items-center justify-center shadow-lg shadow-brand-600/25 mb-6 md:mb-8">
          <i data-lucide="brain" class="w-8 h-8 md:w-10 md:h-10 text-white"></i>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold font-display text-surface-50 mb-3 md:mb-4" data-i18n="onboarding.slide1.title">Welcome to HAPI</h1>
        <p class="text-base md:text-lg text-surface-400 max-w-2xl leading-relaxed" data-i18n="onboarding.slide1.desc">
          HAPI (Human Activity Pattern Intelligence) adalah teman pintar yang memantau kelelahanmu, mengelola mood, dan menjaga produktivitasmu tetap seimbang.
        </p>
      </div>

      <!-- Slide 2: Dashboard -->
      <div class="w-full shrink-0 h-full flex flex-col items-center justify-center p-6 md:p-16 text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-surface-800 flex items-center justify-center mb-6 md:mb-8 border border-surface-700">
          <i data-lucide="layout-dashboard" class="w-8 h-8 md:w-10 md:h-10 text-brand-400"></i>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold font-display text-surface-50 mb-3 md:mb-4" data-i18n="onboarding.slide2.title">Kenali Dashboard-mu</h2>
        <p class="text-base md:text-lg text-surface-400 max-w-2xl leading-relaxed" data-i18n="onboarding.slide2.desc">
          Pusat kendali harianmu. Lihat skor risikomu saat ini, tren kelelahan selama 7 hari terakhir, dan wawasan AI yang disesuaikan dengan kondisimu.
        </p>
      </div>

      <!-- Slide 3: Pomodoro -->
      <div class="w-full shrink-0 h-full flex flex-col items-center justify-center p-6 md:p-16 text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-surface-800 flex items-center justify-center mb-6 md:mb-8 border border-surface-700">
          <i data-lucide="timer" class="w-8 h-8 md:w-10 md:h-10 text-accent-teal"></i>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold font-display text-surface-50 mb-3 md:mb-4" data-i18n="onboarding.slide3.title">Pomodoro Pintar</h2>
        <p class="text-base md:text-lg text-surface-400 max-w-2xl leading-relaxed" data-i18n="onboarding.slide3.desc">
          Bukan sekadar timer biasa. HAPI merekomendasikan waktu fokus dan istirahat yang ideal berdasarkan tingkat kelelahan dan mood aslimu hari ini.
        </p>
      </div>

      <!-- Slide 4: Analytic -->
      <div class="w-full shrink-0 h-full flex flex-col items-center justify-center p-6 md:p-16 text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-surface-800 flex items-center justify-center mb-6 md:mb-8 border border-surface-700">
          <i data-lucide="bar-chart-3" class="w-8 h-8 md:w-10 md:h-10 text-accent-purple"></i>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold font-display text-surface-50 mb-3 md:mb-4" data-i18n="onboarding.slide4.title">Analitik Mendalam</h2>
        <p class="text-base md:text-lg text-surface-400 max-w-2xl leading-relaxed" data-i18n="onboarding.slide4.desc">
          Pantau riwayat aktivitasmu melalui kalender interaktif. Hubungkan kalender Google-mu untuk melihat korelasi antara jadwal rapat dan risiko burnout.
        </p>
      </div>

      <!-- Slide 5: Quiz -->
      <div class="w-full shrink-0 h-full flex flex-col items-center justify-center p-6 md:p-16 text-center">
        <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-surface-800 flex items-center justify-center mb-6 md:mb-8 border border-surface-700">
          <i data-lucide="clipboard-check" class="w-8 h-8 md:w-10 md:h-10 text-accent-pink"></i>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold font-display text-surface-50 mb-3 md:mb-4" data-i18n="onboarding.slide5.title">Quiz Kelelahan & Streak</h2>
        <p class="text-base md:text-lg text-surface-400 max-w-2xl leading-relaxed mb-6 md:mb-8" data-i18n="onboarding.slide5.desc">
          Kunci utama HAPI. Isi kuesioner atau catat mood setiap hari untuk mengukur tingkat kelelahanmu. Jaga <strong>streak harianmu</strong> tetap aktif untuk membangun kebiasaan produktif yang sehat! 🔥
        </p>
        <button id="btn-start-onboarding" class="btn-primary btn-lg shadow-lg shadow-brand-600/20 px-6 md:px-10 hover:scale-105 transition-transform inline-flex items-center gap-2">
          <span data-i18n="onboarding.start">Mulai Quiz Pertamamu</span>
          <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </button>
      </div>

    </div>

    <!-- Navigation Footer -->
    <div class="p-6 border-t border-surface-700/30 flex items-center justify-between bg-surface-900/50">
      <button id="btn-prev" class="btn-secondary px-6 opacity-0 pointer-events-none transition-opacity" data-i18n="onboarding.prev">
        <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i> Sebelumnya
      </button>
      
      <!-- Slide Indicators -->
      <div class="flex items-center gap-2" id="slide-indicators">
        <div class="w-2.5 h-2.5 rounded-full bg-brand-500 transition-all indicator"></div>
        <div class="w-2 h-2 rounded-full bg-surface-600 transition-all indicator"></div>
        <div class="w-2 h-2 rounded-full bg-surface-600 transition-all indicator"></div>
        <div class="w-2 h-2 rounded-full bg-surface-600 transition-all indicator"></div>
        <div class="w-2 h-2 rounded-full bg-surface-600 transition-all indicator"></div>
      </div>

      <button id="btn-next" class="btn-primary px-6" data-i18n="onboarding.next">
        Selanjutnya <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
      </button>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let currentSlide = 0;
    const totalSlides = 5;
    
    const slidesContainer = document.getElementById('onboarding-slides');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const indicators = document.querySelectorAll('.indicator');
    
    function updateCarousel() {
      // Move slides container
      slidesContainer.style.transform = `translateX(-${currentSlide * 100}%)`;
      
      // Update indicators
      indicators.forEach((ind, index) => {
        if (index === currentSlide) {
          ind.className = 'w-2.5 h-2.5 rounded-full bg-brand-500 transition-all indicator';
        } else {
          ind.className = 'w-2 h-2 rounded-full bg-surface-600 transition-all indicator cursor-pointer';
        }
      });
      
      // Update Prev Button
      if (currentSlide === 0) {
        btnPrev.classList.add('opacity-0', 'pointer-events-none');
      } else {
        btnPrev.classList.remove('opacity-0', 'pointer-events-none');
      }
      
      // Update Next Button
      if (currentSlide === totalSlides - 1) {
        btnNext.classList.add('hidden');
      } else {
        btnNext.classList.remove('hidden');
      }
    }
    
    btnNext.addEventListener('click', () => {
      if (currentSlide < totalSlides - 1) {
        currentSlide++;
        updateCarousel();
      }
    });
    
    btnPrev.addEventListener('click', () => {
      if (currentSlide > 0) {
        currentSlide--;
        updateCarousel();
      }
    });

    // Start button
    const startBtn = document.getElementById('btn-start-onboarding');
    if (startBtn) {
      startBtn.addEventListener('click', async () => {
        startBtn.disabled = true;
        startBtn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> <span data-i18n="onboarding.loading">Memproses...</span>';
        if (window.lucide) lucide.createIcons();
        
        try {
          const res = await window.hapiApi.completeOnboarding();
          if (res.data.success) {
            window.location.href = '/quiz';
          }
        } catch (err) {
          console.error(err);
          if (window.showToast) window.showToast('Gagal memproses, silakan coba lagi.', 'error');
          startBtn.disabled = false;
          startBtn.innerHTML = '<span data-i18n="onboarding.start">Mulai Quiz Pertamamu</span> <i data-lucide="arrow-right" class="w-5 h-5"></i>';
          if (window.lucide) lucide.createIcons();
        }
      });
    }

    updateCarousel();
  });
</script>
