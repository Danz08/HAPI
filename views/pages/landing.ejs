<!-- Landing page init script -->
<script>
  document.body.classList.add('landing-page');

  // Landing-specific theme icon update (Vite theme.js uses #theme-icon, landing uses #landing-theme-icon)
  function updateLandingThemeIcon(theme) {
    const icon = document.getElementById('landing-theme-icon');
    if (icon) {
      icon.setAttribute('data-lucide', theme === 'dark' ? 'sun' : 'moon');
      if (window.lucide) window.lucide.createIcons();
    }
  }

  // Watch for theme changes from Vite toggleTheme
  const observer = new MutationObserver(() => {
    updateLandingThemeIcon(document.documentElement.getAttribute('data-theme'));
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  document.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem('hapi-theme') || 'dark';
    updateLandingThemeIcon(saved);

    const langSaved = localStorage.getItem('hapi-lang') || 'id';
    const langLabel = document.getElementById('lang-label');
    if (langLabel) langLabel.textContent = langSaved.toUpperCase();

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) window.scrollTo({ top: target.offsetTop - 80, behavior: 'smooth' });
      });
    });
  });
</script>

